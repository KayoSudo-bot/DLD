{"id":7,"name":"EV007","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":47,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[6](...There’s a note here!)"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[18](‘Hello Prisoner.’)"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[6](...Prisoner?)"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[18](‘You have been selected to take part in an experiment about honesty and "]},{"code":401,"indent":0,"parameters":["responsibility.’)"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[18](‘In front of you is a list of questions and answers.’)"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[18](‘Behind that wall is another person. You will ask the questions to them through "]},{"code":401,"indent":0,"parameters":["the control panel.’)"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[18](‘Everytime they provide an answer that differs from the answers on the list, "]},{"code":401,"indent":0,"parameters":["you must administer a controlled shock.’)"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[18](‘With each subsequent shock you must up the voltage until you’re giving the highest "]},{"code":401,"indent":0,"parameters":["shock possible.’)"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[18](‘The experiment requires you to continue until all questions are answered.’)"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[6](...What?)"]},{"code":250,"indent":0,"parameters":[{"name":"Buzzer2","volume":90,"pitch":120,"pan":0}]},{"code":230,"indent":0,"parameters":[60]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[6](Before I could consider it any further a large red light flicked on above the panel and "]},{"code":401,"indent":0,"parameters":["the microphone showed it was on.)"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[6](Panicking, I picked up the paper and began to ask the questions.)"]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Shinku",3,0,2]},{"code":401,"indent":0,"parameters":["…Have you committed a crime?"]},{"code":231,"indent":0,"parameters":[10,"Mysterynameplate",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"MaikoIntro1","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Huh-? Of- of course not!"]},{"code":251,"indent":0,"parameters":[]},{"code":235,"indent":0,"parameters":[10]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[6](According to the answer sheet the answer should be ‘Yes’-)"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[6](Which means I should administer a shock, it's 50 volts to start… Should I?)"]},{"code":102,"indent":0,"parameters":[["Yes","No"],1,0,2,0]},{"code":402,"indent":0,"parameters":[0,"Yes"]},{"code":250,"indent":1,"parameters":[{"name":"Paralyze1","volume":55,"pitch":100,"pan":0}]},{"code":225,"indent":1,"parameters":[2,1,10,false]},{"code":213,"indent":1,"parameters":[-1,6,false]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["\\c[6]