{"id":17,"name":"EV017","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":26,"switch1Valid":true,"switch2Id":21,"switch2Valid":true,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Alora placeholder","direction":8,"pattern":1,"characterIndex":0},"list":[{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Shinku3",7,0,2]},{"code":401,"indent":0,"parameters":["Are you not busy with your Dare today, Dr Alenius?"]},{"code":231,"indent":0,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Alora",3,0,2]},{"code":401,"indent":0,"parameters":["Absolutely not, I see no reason to engage in mine. It feels needlessly "]},{"code":401,"indent":0,"parameters":["frustrating. "]},{"code":101,"indent":0,"parameters":["Alora3",2,0,2]},{"code":401,"indent":0,"parameters":["My Truth is embarrassing, yes. But it’s not worth engaging in my dare "]},{"code":401,"indent":0,"parameters":["to hide it."]},{"code":101,"indent":0,"parameters":["Alora3",5,0,2]},{"code":401,"indent":0,"parameters":["Besides, doing so would just hinder progress on finding an escape… "]},{"code":401,"indent":0,"parameters":["Which is the last thing I want to do right now. With this new motive "]},{"code":401,"indent":0,"parameters":["in place, time is precious."]},{"code":101,"indent":0,"parameters":["Alora2",3,0,2]},{"code":401,"indent":0,"parameters":["…I just hope you’ll all understand when my Truth comes out tomorrow. "]},{"code":401,"indent":0,"parameters":["I don’t want people being unreasonable about it."]},{"code":235,"indent":0,"parameters":[10]},{"code":102,"indent":0,"parameters":[["It's probably not bad.","You do so much it doesn’t matter","I don't know..."],1,0,1,0]},{"code":402,"indent":0,"parameters":[0,"It's probably not bad."]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku",7,0,2]},{"code":401,"indent":1,"parameters":["I mean, you said it yourself. Your secret is more embarrassing than "]},{"code":401,"indent":1,"parameters":["anything. "]},{"code":101,"indent":1,"parameters":["Shinku3",6,0,2]},{"code":401,"indent":1,"parameters":["I don’t see any reason why anyone will have any hang ups about it "]},{"code":401,"indent":1,"parameters":["if it’s not that bad at all."]},{"code":231,"indent":1,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Alora",7,0,2]},{"code":401,"indent":1,"parameters":["I suppose… It just seems some people here will jump onto anything."]},{"code":101,"indent":1,"parameters":["Alora",3,0,2]},{"code":401,"indent":1,"parameters":["Not to mention I’m sure some people are growing frustrated by how long "]},{"code":401,"indent":1,"parameters":["it’s taking me to make progress… They’ll be looking for any reason to "]},{"code":401,"indent":1,"parameters":["justify that frustration."]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku3",5,0,2]},{"code":401,"indent":1,"parameters":["But for every one person who thinks that, there’s about 3 of us who "]},{"code":401,"indent":1,"parameters":["appreciate all the hard work you’re putting in. So… Don’t worry. "]},{"code":401,"indent":1,"parameters":["We’ll defend you."]},{"code":231,"indent":1,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Alora3",6,0,2]},{"code":401,"indent":1,"parameters":["…Thank you, Kutsuki."]},{"code":101,"indent":1,"parameters":["Alora3",5,0,2]},{"code":401,"indent":1,"parameters":["If you’d like, you’re free to keep me company while I work. It might be "]},{"code":401,"indent":1,"parameters":["best to stay away from the others today if they’re busy with their dares."]},{"code":235,"indent":1,"parameters":[10]},{"code":102,"indent":1,"parameters":[["Yes","No"],1,0,1,0]},{"code":402,"indent":1,"parameters":[0,"Yes"]},{"code":231,"indent":2,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":2,"parameters":["Shinku3",6,0,2]},{"code":401,"indent":2,"parameters":["I’d like that a lot."]},{"code":231,"indent":2,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":2,"parameters":["Alora3",6,0,2]},{"code":401,"indent":2,"parameters":["Alright, very well."]},{"code":235,"indent":2,"parameters":[10]},{"code":235,"indent":2,"parameters":[10]},{"code":221,"indent":2,"parameters":[]},{"code":230,"indent":2,"parameters":[100]},{"code":222,"indent":2,"parameters":[]},{"code":117,"indent":2,"parameters":[78]},{"code":0,"indent":2,"parameters":[]},{"code":402,"indent":1,"parameters":[1,"No"]},{"code":231,"indent":2,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":2,"parameters":["Shinku",2,0,2]},{"code":401,"indent":2,"parameters":["Maybe another time… But good luck with all this."]},{"code":231,"indent":2,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":2,"parameters":["Alora",3,0,2]},{"code":401,"indent":2,"parameters":["Thank you, Kutsuki. Stay safe. "]},{"code":235,"indent":2,"parameters":[10]},{"code":0,"indent":2,"parameters":[]},{"code":404,"indent":1,"parameters":[]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[1,"You do so much it doesn’t matter"]},{"code":231,"indent":1,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Alora2",6,0,2]},{"code":401,"indent":1,"parameters":["…What do you mean?"]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku",7,0,2]},{"code":401,"indent":1,"parameters":["I mean, you’re always doing so much to help around here… Helping with "]},{"code":401,"indent":1,"parameters":["the Corrupt prisoners, planning the escape, helping Asuga heal, keeping "]},{"code":401,"indent":1,"parameters":["Taka in check-"]},{"code":101,"indent":1,"parameters":["Shinku4",1,0,2]},{"code":401,"indent":1,"parameters":["You could do something absolutely awful and we’d still forgive you, "]},{"code":401,"indent":1,"parameters":["we rely on you."]},{"code":231,"indent":1,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Alora",7,0,2]},{"code":401,"indent":1,"parameters":["…Is that so?"]},{"code":235,"indent":1,"parameters":[10]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["\\c[6](Something about what I’d said seemed to have disturbed Dr Alenius "]},{"code":401,"indent":1,"parameters":["slightly, but she turned to her work to hide it.)"]},{"code":231,"indent":1,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Alora",3,0,2]},{"code":401,"indent":1,"parameters":["…Well, I’m going to get on with my work. Stay safe, Kutsuki. "]},{"code":235,"indent":1,"parameters":[10]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["\\c[6](...I should leave her to get on with things, I think I’d said something "]},{"code":401,"indent":1,"parameters":["wrong.)"]},{"code":123,"indent":1,"parameters":["A",0]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[2,"I don't know..."]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku2",1,0,2]},{"code":401,"indent":1,"parameters":["You’ve seen some of the people here… Asking them to be reasonable is "]},{"code":401,"indent":1,"parameters":["practically futile. "]},{"code":101,"indent":1,"parameters":["Shinku",5,0,2]},{"code":401,"indent":1,"parameters":["I mean, I’m convinced some people here just want to cause issues for "]},{"code":401,"indent":1,"parameters":["no reason."]},{"code":231,"indent":1,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Alora",3,0,2]},{"code":401,"indent":1,"parameters":["…Ah. Right. I’d forgotten."]},{"code":101,"indent":1,"parameters":["Alora",7,0,2]},{"code":401,"indent":1,"parameters":["I suppose I’ll just have to brace myself for ridicule, I hoped I’d be "]},{"code":401,"indent":1,"parameters":["able to avoid it…"]},{"code":101,"indent":1,"parameters":["Alora3",5,0,2]},{"code":401,"indent":1,"parameters":["…Maybe I’ll prepare an explanation in advance."]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku",2,0,2]},{"code":401,"indent":1,"parameters":["That might be wise, haha-"]},{"code":235,"indent":1,"parameters":[10]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["\\c[6](Dr Alenius turned back to her work, her mind drifting elsewhere… "]},{"code":401,"indent":1,"parameters":["I shouldn’t disturb her. She’s probably busy.)"]},{"code":123,"indent":1,"parameters":["A",0]},{"code":0,"indent":1,"parameters":[]},{"code":404,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":26,"switch1Valid":true,"switch2Id":21,"switch2Valid":true,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Alora placeholder","direction":8,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[6](I should leave her to her work, she seems busy enough already.