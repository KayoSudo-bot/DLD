{"id":13,"name":"EV013","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":10,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"fu","direction":8,"pattern":1,"characterIndex":0},"list":[{"code":231,"indent":0,"parameters":[10,"Funameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Fu",3,0,2]},{"code":401,"indent":0,"parameters":["Finally, something good in this prison. Jack Daniels, Malibu, amaretto… Damn, "]},{"code":401,"indent":0,"parameters":["they’ve got everything here. Scrunchie wasn’t lying."]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Shinku4",6,0,2]},{"code":401,"indent":0,"parameters":["Uh… Feeling better after getting something to drink in your system?"]},{"code":231,"indent":0,"parameters":[10,"Funameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Fu",5,0,2]},{"code":401,"indent":0,"parameters":["Mighty better, heh. Ah, sorry if I was harsh before… Just needed a good "]},{"code":401,"indent":0,"parameters":["drink to soften me out, y’know?"]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Shinku",5,0,2]},{"code":401,"indent":0,"parameters":["…Yeah, sure… "]},{"code":231,"indent":0,"parameters":[10,"Funameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Fu3",1,0,2]},{"code":401,"indent":0,"parameters":["Hm… Hey, wait- where’s the broad you were with? Scrunchie? I gotta thank "]},{"code":401,"indent":0,"parameters":["her for finding the jackpot."]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Shinku2",0,0,2]},{"code":401,"indent":0,"parameters":["Oh, she went off with Takiko to find the… Guy she was with earlier."]},{"code":231,"indent":0,"parameters":[10,"Funameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Fu3",3,0,2]},{"code":401,"indent":0,"parameters":["Damn, she has a boyfriend? Sorry, man, maybe the next one. She was too pretty "]},{"code":401,"indent":0,"parameters":["for you anyway, probably gonna cheat."]},{"code":101,"indent":0,"parameters":["Fu2",7,0,2]},{"code":401,"indent":0,"parameters":["Life's more fun when you’re not tied down to a woman anyway, mark my words. "]},{"code":401,"indent":0,"parameters":["If I was still married I couldn’t go out drinking and living it high every night,"]},{"code":401,"indent":0,"parameters":["y’know?"]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Shinku2",2,0,2]},{"code":401,"indent":0,"parameters":["…Yeah, sure, but I’m going to go uh- try and find my friends now."]},{"code":231,"indent":0,"parameters":[10,"Funameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Fu2",3,0,2]},{"code":401,"indent":0,"parameters":["Best of luck, I’ll be here until they start casting us for our ransom "]},{"code":401,"indent":0,"parameters":["videos. "]},{"code":235,"indent":0,"parameters":[10]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[6](...He really doesn’t seem concerned about the situation at all!)"]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":5,"y":6},
