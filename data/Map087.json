{"id":17,"name":"EV017","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":32,"switch1Valid":true,"switch2Id":21,"switch2Valid":true,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"taka","direction":6,"pattern":1,"characterIndex":0},"list":[{"code":231,"indent":0,"parameters":[10,"Takanameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Taka",4,0,2]},{"code":401,"indent":0,"parameters":["Shinku! Happy Valentine’s! Got much chocolate today?"]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Shinku2",5,0,2]},{"code":401,"indent":0,"parameters":["Uh… No. You seem excited though-"]},{"code":231,"indent":0,"parameters":[10,"Takanameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Taka3",6,0,2]},{"code":401,"indent":0,"parameters":["Wow! We have so much in common, I didn’t even either!"]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Shinku",2,0,2]},{"code":401,"indent":0,"parameters":["…You sound weirdly enthusiastic about that????"]},{"code":231,"indent":0,"parameters":[10,"Takanameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Taka3",4,0,2]},{"code":401,"indent":0,"parameters":["Well, most other Valentine’s Days I was alone until I moved to Japan… "]},{"code":401,"indent":0,"parameters":["And then my female staff would give me ‘obligation chocolate’ every year,"]},{"code":401,"indent":0,"parameters":["but they really knew how to put the ‘obligation’ into it."]},{"code":101,"indent":0,"parameters":["Taka2",7,0,2]},{"code":401,"indent":0,"parameters":["It never really meant all that much to me, but I wasn’t complaining! "]},{"code":401,"indent":0,"parameters":["It was still yummy, yummy in my tummy!"]},{"code":101,"indent":0,"parameters":["Taka3",2,0,2]},{"code":401,"indent":0,"parameters":["…But I remember I came off set on my second Valentine’s day in Japan, "]},{"code":401,"indent":0,"parameters":["I’d just finished recording a session when I heard all sorts of commotion "]},{"code":401,"indent":0,"parameters":["coming from the barriers."]},{"code":101,"indent":0,"parameters":["Taka",0,0,2]},{"code":401,"indent":0,"parameters":["It was Sugi, quarreling with security to let her in now we’d finished "]},{"code":401,"indent":0,"parameters":["recording…"]},{"code":101,"indent":0,"parameters":["Taka3",2,0,2]},{"code":401,"indent":0,"parameters":["She’d made me some sort of special chocolate truffles, but I’d been so "]},{"code":401,"indent":0,"parameters":["busy with work that by the time she was able to get to me it was all "]},{"code":401,"indent":0,"parameters":["melty and sticky and gross-"]},{"code":101,"indent":0,"parameters":["Taka2",1,0,2]},{"code":401,"indent":0,"parameters":["…But she wanted to give it to me anyway, she said ‘it didn’t mean anything "]},{"code":401,"indent":0,"parameters":["big, she just wanted to make sure I was able to have a proper Japanese "]},{"code":401,"indent":0,"parameters":["Valentine’s day experience’."]},{"code":101,"indent":0,"parameters":["Taka",5,0,2]},{"code":401,"indent":0,"parameters":["We ended up sitting just outside the studio together, taking turns spooning "]},{"code":401,"indent":0,"parameters":["out the melted chocolate and sharing it. I remember giggling and laughing "]},{"code":401,"indent":0,"parameters":["and giggling, gosh! It was fun!"]},{"code":101,"indent":0,"parameters":["Taka",6,0,2]},{"code":401,"indent":0,"parameters":["…What was less fun was discovering white day was only a thing AFTER it"]},{"code":401,"indent":0,"parameters":["had already passed and I’d forgotten to get Sugi anything-"]},{"code":101,"indent":0,"parameters":["Taka2",7,0,2]},{"code":401,"indent":0,"parameters":["BUT! This year it will be different! Different I tell you! I’ll make up "]},{"code":401,"indent":0,"parameters":["for last year however I can, even if we’re stuck here!"]},{"code":101,"indent":0,"parameters":["Taka2",1,0,2]},{"code":401,"indent":0,"parameters":["I may not be able to cook, but I have exactly a month to gather whatever "]},{"code":401,"indent":0,"parameters":["sweet treats Lori gives me and save them to make something nice for Sugi!"]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Shinku4",6,0,2]},{"code":401,"indent":0,"parameters":["…Are you sure that’s going to be nice?"]},{"code":231,"indent":0,"parameters":[10,"Takanameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Taka",2,0,2]},{"code":401,"indent":0,"parameters":["It has to be! I have to make it up to them! "]},{"code":101,"indent":0,"parameters":["Taka2",7,0,2]},{"code":401,"indent":0,"parameters":["Even if it’s melty and kinda gross, I want to put the thought and energy in! "]},{"code":401,"indent":0,"parameters":["That’s what counts!"]},{"code":101,"indent":0,"parameters":["Taka2",1,0,2]},{"code":401,"indent":0,"parameters":["It wasn’t the chocolate that made Valentine’s nice last year… "]},{"code":401,"indent":0,"parameters":["It was Sugi’s company. So… Maybe it doesn’t matter if the treat is "]},{"code":401,"indent":0,"parameters":["good, as long as the thought is there it’ll be enough for me!"]},{"code":101,"indent":0,"parameters":["Taka2",4,0,2]},{"code":401,"indent":0,"parameters":["Besides! It’s a foolproof plan! My birthday is just before white day, "]},{"code":401,"indent":0,"parameters":["Lori is bound to give me a bunch of treats then! So I’ll be sure to "]},{"code":401,"indent":0,"parameters":["have enough!"]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Shinku3",5,0,2]},{"code":401,"indent":0,"parameters":["…You’re a lot sweeter than I would’ve expected, Taka."]},{"code":231,"indent":0,"parameters":[10,"Takanameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Taka2",2,0,2]},{"code":401,"indent":0,"parameters":["Hm? What? You jealous all of a sudden, Shinky-poo?"]},{"code":101,"indent":0,"parameters":["Taka",4,0,2]},{"code":401,"indent":0,"parameters":["Well, don’t you worry! You’ll always be my number two!"]},{"code":101,"indent":0,"parameters":["Taka3",2,0,2]},{"code":401,"indent":0,"parameters":["Or, well, number three- Lori is number two, she’s done a lot for "]},{"code":401,"indent":0,"parameters":["me!"]},{"code":101,"indent":0,"parameters":["Taka2",7,0,2]},{"code":401,"indent":0,"parameters":["But number three is still good! Good on you, Shinky-poo!"]},{"code":101,"indent":0,"parameters":["Taka2",4,0,2]},{"code":401,"indent":0,"parameters":["In fact, if you’d like- I’ll be all yours for the rest of the day! "]},{"code":401,"indent":0,"parameters":["What do you say? Wanna spend some time with me?"]},{"code":235,"indent":0,"parameters":[10]},{"code":102,"indent":0,"parameters":[["Alright...","No thanks"],1,0,2,0]},{"code":402,"indent":0,"parameters":[0,"Alright..."]},{"code":231,"indent":1,"parameters":[10,"Takanameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Taka2",7,0,2]},{"code":401,"indent":1,"parameters":["Really? Oh, thank you so much! Isn’t this exciting? I knew you liked me, "]},{"code":401,"indent":1,"parameters":["Shinky-poo!"]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku",3,0,2]},{"code":401,"indent":1,"parameters":["N-not like that! The fact it’s Valentine’s day has nothing to do "]},{"code":401,"indent":1,"parameters":["with this!"]},{"code":235,"indent":1,"parameters":[10]},{"code":235,"indent":1,"parameters":[10]},{"code":221,"indent":1,"parameters":[]},{"code":230,"indent":1,"parameters":[100]},{"code":222,"indent":1,"parameters":[]},{"code":117,"indent":1,"parame