s, I think it would be good for both of "]},{"code":401,"indent":2,"parameters":["us."]},{"code":231,"indent":2,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":2,"parameters":["Alora2",0,0,2]},{"code":401,"indent":2,"parameters":["Wonderful."]},{"code":235,"indent":2,"parameters":[10]},{"code":235,"indent":2,"parameters":[10]},{"code":221,"indent":2,"parameters":[]},{"code":230,"indent":2,"parameters":[100]},{"code":222,"indent":2,"parameters":[]},{"code":117,"indent":2,"parameters":[78]},{"code":0,"indent":2,"parameters":[]},{"code":402,"indent":1,"parameters":[1,"No thanks"]},{"code":231,"indent":2,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":2,"parameters":["Shinku",2,0,2]},{"code":401,"indent":2,"parameters":["I appreciate the offer, but I’ve got other things to do."]},{"code":231,"indent":2,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":2,"parameters":["Alora3",5,0,2]},{"code":401,"indent":2,"parameters":["Very well, let me know if you change your mind. "]},{"code":235,"indent":2,"parameters":[10]},{"code":0,"indent":2,"parameters":[]},{"code":404,"indent":1,"parameters":[]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[2,"Has Maiko been fed?"]},{"code":231,"indent":1,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Alora2",6,0,2]},{"code":401,"indent":1,"parameters":["…It completely slipped my mind, I apologise."]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku",6,0,2]},{"code":401,"indent":1,"parameters":["Hey, it’s okay, I know you’re busy. If you want, I don’t mind-"]},{"code":231,"indent":1,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Alora2",3,0,2]},{"code":401,"indent":1,"parameters":["Nono, it’s quite alright. Just let me finish this and I’ll get right to "]},{"code":401,"indent":1,"parameters":["it."]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku",2,0,2]},{"code":401,"indent":1,"parameters":["…If you insist."]},{"code":235,"indent":1,"parameters":[10]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["\\c[6](I won’t be able to convince her otherwise, I should let her get "]},{"code":401,"indent":1,"parameters":["on with her work so she gets to it quicker… I just wish she’d let "]},{"code":401,"indent":1,"parameters":["one of us take some of the workload off of her shoulders.)"]},{"code":123,"indent":1,"parameters":["A",0]},{"code":0,"indent":1,"parameters":[]},{"code":404,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":28,"switch1Valid":true,"switch2Id":21,"switch2Valid":true,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Alora placeholder","direction":8,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[6](I shouldn't disturb her, she's busy with work.)"]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":2,"y":4},
