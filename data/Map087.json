{"id":8,"name":"EV008","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":47,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\C[6](It's a memo notifying that the place had been cleaned...)"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\C[6]('Miss Carmine, you may notice there is still blood all over this room.')"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\C[6]('Due to my ongoing protest I REFUSE to clean up the blood.')"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\C[6]('However, I did remove the body that was stored in the cell.')"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\C[6]('...It seemed fresher than I had anticipated, who did you get this facility from again?')"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\C[6]('I know you 'anti-ultimaters' are against thinking too hard about anything but still-')"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\C[6]('I suppose it doesn't matter.')"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\C[6]('Given your attitude, I doubt you're the one behind this.')"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\C[6]('Still, I insist you listen to my concerns.')"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[6]('Kind regards, K.A (Head of cleaning and Maintenance (Janitor.)')"]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":8,"y":9},
{"id":9,"name":"EV009","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":28,"switch1Valid":true,"switch2Id":21,"switch2Valid":true,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Alora placeholder","direction":8,"pattern":1,"characterIndex":0},"list":[{"code":231,"indent":0,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Alora",3,0,2]},{"code":401,"indent":0,"parameters":["…Sorry… It’s hard to get a single moment of peace with everyone "]},{"code":401,"indent":0,"parameters":["constantly hounding me."]},{"code":101,"indent":0,"parameters":["Alora",7,0,2]},{"code":401,"indent":0,"parameters":["I apologise, really. I am hearing what you’re saying, but… Between Shatel, "]},{"code":401,"indent":0,"parameters":["Takahiro and Wang… I’ve hardly-"]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Shinku",2,0,2]},{"code":401,"indent":0,"parameters":["Uhm… Dr Alenius? Who are you talking to?"]},{"code":231,"indent":0,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Alora2",6,0,2]},{"code":401,"indent":0,"parameters":["Ah! Kutsuki-!"]},{"code":235,"indent":0,"parameters":[10]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[6](Dr Alenius quickly flicked around, seemingly a little startled.)"]},{"code":231,"indent":0,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Alora3",5,0,2]},{"code":401,"indent":0,"parameters":["I apologise… I was just thinking outloud, can I help you? "]},{"code":235,"indent":0,"parameters":[10]},{"code":102,"indent":0,"parameters":[["Were you really doing that?","I just wanted to check in","Has Maiko been fed?"],1,0,1,0]},{"code":402,"indent":0,"parameters":[0,"Were you really doing that?"]},{"code":231,"indent":1,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Alora",6,0,2]},{"code":401,"indent":1,"parameters":["I’m not sure what you mean..?"]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku",7,0,2]},{"code":401,"indent":1,"parameters":["…Maybe I’m just overthinking things, but it sounded a lot more conversational "]},{"code":401,"indent":1,"parameters":["to me-"]},{"code":231,"indent":1,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Alora",2,0,2]},{"code":401,"indent":1,"parameters":["..."]},{"code":101,"indent":1,"parameters":["Alora",3,0,2]},{"code":401,"indent":1,"parameters":["I apologise, it’s a disruptive habit. I know. I’ll try to get better "]},{"code":401,"indent":1,"parameters":["at thinking in my head."]},{"code":101,"indent":1,"parameters":["Alora3",1,0,2]},{"code":401,"indent":1,"parameters":["Now if you don’t mind me, I believe it’s best if I get back to work. "]},{"code":401,"indent":1,"parameters":["I got distracted today."]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku",3,0,2]},{"code":401,"indent":1,"parameters":["…Alright. Whatever you say."]},{"code":235,"indent":1,"parameters":[10]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["\\c[6](I’m not going to push it any further.)"]},{"code":123,"indent":1,"parameters":["A",0]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[1,"I just wanted to check in"]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku3",5,0,2]},{"code":401,"indent":1,"parameters":["I just wanted to check up on you, you’ve been working so hard… "]},{"code":401,"indent":1,"paramete