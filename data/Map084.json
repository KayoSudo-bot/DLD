{"id":1,"name":"EV001","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":135,"indent":0,"parameters":[1]},{"code":134,"indent":0,"parameters":[1]},{"code":235,"indent":0,"parameters":[10]},{"code":230,"indent":0,"parameters":[200]},{"code":121,"indent":0,"parameters":[22,22,1]},{"code":121,"indent":0,"parameters":[23,23,1]},{"code":121,"indent":0,"parameters":[25,25,1]},{"code":121,"indent":0,"parameters":[27,27,1]},{"code":121,"indent":0,"parameters":[29,29,1]},{"code":121,"indent":0,"parameters":[31,31,1]},{"code":121,"indent":0,"parameters":[37,37,1]},{"code":121,"indent":0,"parameters":[82,82,1]},{"code":121,"indent":0,"parameters":[83,83,1]},{"code":121,"indent":0,"parameters":[84,84,1]},{"code":121,"indent":0,"parameters":[85,85,1]},{"code":121,"indent":0,"parameters":[86,86,1]},{"code":121,"indent":0,"parameters":[87,87,1]},{"code":121,"indent":0,"parameters":[88,88,1]},{"code":121,"indent":0,"parameters":[89,89,1]},{"code":121,"indent":0,"parameters":[90,90,1]},{"code":121,"indent":0,"parameters":[91,91,1]},{"code":121,"indent":0,"parameters":[92,92,1]},{"code":121,"indent":0,"parameters":[93,93,1]},{"code":121,"indent":0,"parameters":[94,94,1]},{"code":121,"indent":0,"parameters":[96,96,1]},{"code":121,"indent":0,"parameters":[80,80,1]},{"code":121,"indent":0,"parameters":[38,38,0]},{"code":242,"indent":0,"parameters":[2]},{"code":221,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[100]},{"code":231,"indent":0,"parameters":[5,"Chapter2opener",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"Chapter opening","volume":30,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,2,2]},{"code":401,"indent":0,"parameters":[""]},{"code":251,"indent":0,"parameters":[]},{"code":221,"indent":0,"parameters":[]},{"code":235,"indent":0,"parameters":[5]},{"code":230,"indent":0,"parameters":[100]},{"code":221,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[5,"Emiliacg1",0,0,0,0,100,100,255,0]},{"code":241,"indent":0,"parameters":[{"name":"Emilias theme","volume":15,"pitch":100,"pan":0}]},{"code":222,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[100]},{"code":231,"indent":0,"parameters":[10,"emilianametag",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia1","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Well, well, well. Look at us. Back here again."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia2","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["I know it’s been a while… What? A month and a half? "]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia3","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["If it was up to me we’d be on air again a lot sooner, unfortunately we "]},{"code":401,"indent":0,"parameters":["had some small complications to work out after the murder- "]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia4","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Well. You’ve been left in the dark for a while, so I won’t keep you "]},{"code":401,"indent":0,"parameters":["waiting. I’m sure you’re eager to know what the Prisoners have been "]},{"code":401,"indent":0,"parameters":["up to. "]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia5","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Let me catch you up with the prisoners you judged last time… Starting "]},{"code":401,"indent":0,"parameters":["with Prisoner 02, Lyra Shatel."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia6","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["With her it was a bit of split, back and forth, back and forth-"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia7","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["She was leaning pretty heavily towards Worthy for a *long* while… What? "]},{"code":401,"indent":0,"parameters":["Did you think she was pretty or something?"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia8","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Or maybe you just wanted to encourage the cycle she was in. I’m not "]},{"code":401,"indent":0,"parameters":["going to judge."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia9","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["All I’m saying is that if you voted her Worthy, I’m sure she’d see it "]},{"code":401,"indent":0,"parameters":["as you falling for her facade in the same way her victims did."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia10","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Buuuut… Slowly overtime the votes seemed to shift, it looks like some "]},{"code":401,"indent":0,"parameters":["of you started doing some thinking. Maybe you just wanted to uphold her "]},{"code":401,"indent":0,"parameters":["wishes. Or maybe she just started pissing you off. "]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia11","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Whatever the reason was, there was a major shift right near the end… "]},{"code":401,"indent":0,"parameters":["I’m almost convinced there was something fishy afoot. But eh, it’s not "]},{"code":401,"indent":0,"parameters":["my job to investigate that."]},{"code":251,"indent":0,"parameters":[]},{"code":235,"indent":0,"parameters":[10]},{"code":221,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[5,"EmiliaLyra",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[100]},{"code":231,"indent":0,"parameters":[10,"emilianametag",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia12","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Eventually, she was pushed just barely into a Corrupt vote with a close "]},{"code":401,"indent":0,"parameters":["cut 50.2%."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia13b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Holy shit, you were close to a 50/50- huh? I don’t know what we would’ve "]},{"code":401,"indent":0,"parameters":["done if she landed right in the middle. "]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia14b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Being so close to Worthy, despite her corrupt verdict, has definitely seemed "]},{"code":401,"indent":0,"parameters":["to unsettle her a bit-"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia15b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["I think she thought if she got Corrupt she could just go about things her "]},{"code":401,"indent":0,"parameters":["own way… Which, yeah. She’s been doing. "]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia16b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["But cutting it so close has clearly made her do some thinking, her confidence "]},{"code":401,"indent":0,"parameters":["in her own actions has definitely been shaken… "]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia17b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Obviously, she thinks some of you just wanted to take away her agency "]},{"code":401,"indent":0,"parameters":["and disrespect her wishes once again… Or just voted her Worthy because "]},{"code":401,"indent":0,"parameters":["you thought she was hot."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia18b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["But I think you’ve definitely thrown her off. She’s been forced to think, "]},{"code":401,"indent":0,"parameters":["even if she denies it. "]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia19","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["She’s started to seriously reconsider the way things have gone so far, "]},{"code":401,"indent":0,"parameters":["not just discarding people’s belief that she *can* get better as them "]},{"code":401,"indent":0,"parameters":["just being deceived by her somehow."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia20","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Despite this- she is still Corrupt, even if it is just slightly. Meaning "]},{"code":401,"indent":0,"parameters":["her access to kitchen supplies, medication and the showers have been restricted."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia21","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["And her cell has been stripped… Not that it bothers her. She’s been "]},{"code":401,"indent":0,"parameters":["crashing in another Prisoner’s cell…"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia22","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["The same Prisoner who’s helping her effectively circumvent her Corrupt "]},{"code":401,"indent":0,"parameters":["verdict, helping her get food, showers and whatever else she needs like "]},{"code":401,"indent":0,"parameters":["a loyal puppy dog."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia23","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["That person being Prisoner 03, Ezekiel Elias."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia24","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["It seems after 11’s death he needed someone else to latch onto… "]},{"code":401,"indent":0,"parameters":["Or at least he wanted to make sure that no one else left him."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia25b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Which has led to… Some fascinating developments, really. "]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia26b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Him and 02 have started ‘dating’ and have made this relationship "]},{"code":401,"indent":0,"parameters":["very clear to the other prisoners… Telling them that they ‘kiss "]},{"code":401,"indent":0,"parameters":["on the mouth and stuff’."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia27b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["…I’m sure I don’t even need to tell you how much all this pisses off "]},{"code":401,"indent":0,"parameters":["Ismene, in light of what happened to Prisoner 12, Lyra has become her"]},{"code":401,"indent":0,"parameters":["favourite target."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia28b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["The dating thing, circumventing the corrupt effects by sleeping in "]},{"code":401,"indent":0,"parameters":["Zeke’s room… All of it makes her *incredibly* angry. Although, as Zeke’s "]},{"code":401,"indent":0,"parameters":["always with Lyra she almost never has a chance to ‘teach her a lesson’."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia29b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["…But, most other prisoners think it’s just for audience approval. "]},{"code":401,"indent":0,"parameters":["But who’s to say? "]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia30","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["I’d rather just… Move on from that whole dumpster fire and move onto "]},{"code":401,"indent":0,"parameters":["our next prisoner. Prisoner 04, Takiko Uchiyama-"]},{"code":251,"indent":0,"parameters":[]},{"code":235,"indent":0,"parameters":[10]},{"code":221,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[5,"EmiliaTakiko",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[100]},{"code":231,"indent":0,"parameters":[10,"emilianametag",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia31","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["It seems our youngest prisoner struck a nerve with you all. As soon "]},{"code":401,"indent":0,"parameters":["as the votes dropped she almost immediately got Corrupt, with her "]},{"code":401,"indent":0,"parameters":["verdict steadily balancing out and eventually landing on 51% Corrupt."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia32","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["What? Did it hit a little too close to home? "]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia33","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["I mean, I don’t really know how much you can judge her sending her fanbase "]},{"code":401,"indent":0,"parameters":["to harass people when you actively vote to make people’s lives worse. But "]},{"code":401,"indent":0,"parameters":["I guess you’d say it’s totally different."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia34","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Well, whatever you need to say to make yourself feel better about it."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia35","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Takiko tried for a while, she really did. She kept talking to the cameras, "]},{"code":401,"indent":0,"parameters":["kept trying to cheer up your days- kept trying to help others."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia36","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["But after her verdict came in… Something changed."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia37","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["She still looks at the cameras but she’s completely silent… She just stares. "]},{"code":401,"indent":0,"parameters":["I think she feels betrayed."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyBEmilia38","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["But she always knew this was going to happen."]},{"code":251,"indent":0,"paramet