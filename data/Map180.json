"indent":0,"parameters":["lifeless and charred."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyCquestion3","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,2,1]},{"code":401,"indent":0,"parameters":["Six suspects have been brought in for interrogation, with one thing "]},{"code":401,"indent":0,"parameters":["uniting all of them."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyCquestion4","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,2,1]},{"code":401,"indent":0,"parameters":["That uniting factor being that all of them, whether they wished to or "]},{"code":401,"indent":0,"parameters":["not, needed to kill someone. "]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyCquestion5","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,2,1]},{"code":401,"indent":0,"parameters":["It was the only way forward."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyCquestion6","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,2,1]},{"code":401,"indent":0,"parameters":["However, only one was successful. "]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyCquestion7","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,2,1]},{"code":401,"indent":0,"parameters":["But the rest must follow."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyCquestion8","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,2,1]},{"code":401,"indent":0,"parameters":["Else a terrible fate would await them."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DailyCquestion9","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,2,1]},{"code":401,"indent":0,"parameters":["[BEEP]"]},{"code":251,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[60]},{"code":230,"indent":0,"parameters":[100]},{"code":231,"indent":0,"parameters":[5,"Chapter3opener",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"Chapter opening","volume":30,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,2,2]},{"code":401,"indent":0,"parameters":[""]},{"code":251,"indent":0,"parameters":[]},{"code":221,"indent":0,"parameters":[]},{"code":235,"indent":0,"parameters":[5]},{"code":230,"indent":0,"parameters":[100]},{"code":221,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[5,"Emiliacg1",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[100]},{"code":241,"indent":0,"parameters":[{"name":"Emilias theme","volume":10,"pitch":100,"pan":0}]},{"code":231,"indent":0,"parameters":[10,"emilianametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["..."]},{"code":250,"indent":0,"parameters":[{"name":"Emilia Daily 3 1a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["A-ah, is it on?"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"Emilia Daily 3 2a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Welcome back! Shorter break than last time, huh? Only a few weeks-"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"Emilia Daily 3 3a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Things have been ramping up here pretty quickly, the Prisoners seemed "]},{"code":401,"indent":0,"parameters":["to struggle returning to a sense of ‘normalcy’ after everything that "]},{"code":401,"indent":0,"parameters":["happened last time."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"Emilia Daily 3 4a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["I’ll just cut to the chase, I’m sure you’re eager to see what the "]},{"code":401,"indent":0,"parameters":["prison is like now."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"Emilia Daily 3 5a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Let’s start with Prisoner 03, the first you voted on out of the trio, "]},{"code":401,"indent":0,"parameters":["Ezekiel Elias."]},{"code":251,"indent":0,"parameters":[]},{"code":235,"indent":0,"parameters":[10]},{"code":221,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[5,"EmiliaZekeVerdict",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[100]},{"code":231,"indent":0,"parameters":[10,"emilianametag",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"Emilia Daily 3 6a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["By 56.1%, he got voted Worthy of Redemption."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"Emilia Daily 3 7a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Lots of ‘oh it’s not his fault they decided to do all that’, ‘he was "]},{"code":401,"indent":0,"parameters":["just being confident, what’s the issue?’, ‘he was just being immature, "]},{"code":401,"indent":0,"parameters":["he didn’t know they’d take it so seriously’."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"Emilia Daily 3 8a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["All I heard was the exact same excuses that allowed him to get "]},{"code":401,"indent":0,"parameters":["away with it for so long. "]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"Emilia Daily 3 9c","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["No wonder he’s so popular with you all, you think just like him."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"Emilia Daily 3 10a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Being the big, strong real man he is- your judgement means he’s refused "]},{"code":401,"indent":0,"parameters":["to take any of the blame for those he hurt. "]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"Emilia Daily 3 11a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["He’s bound together with another prisoner and assumes, similarly to "]},{"code":401,"indent":0,"parameters":["them, that he doesn’t deserve to be here in the first place."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"Emilia Daily 3 12a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Because of this newfound belief, he’s grown a sense of superiority over "]},{"code":401,"indent":0,"parameters":["the others- believing himself to be on a different level to them."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"Emilia Daily 3 13a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["He’s used this superiority to push down and belittle others that try "]},{"code":401,"indent":0,"parameters":["to challenge him, somehow becoming even more confident at being "]},{"code":401,"indent":0,"parameters":["unreasonably assertive. "]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"Emilia Daily 3 14a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["For how much shit he gave Ismene after her judgement, he’s really not "]},{"code":401,"indent":0,"parameters":["all that dissimilar. "]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"Emilia Daily 3 15a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["I just wonder if his newfound attitude will really keep the people he "]},{"code":401,"indent":0,"parameters":["cares about close… Or if it will just push them away-"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"Emilia Daily 3 16a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["I mean, his confidence is already causing the occasional argument between "]},{"code":401,"indent":0,"parameters":["him and 02-"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"Emilia Daily 3 17a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Seems like he’s intent on keeping her alive no matter what, even if "]},{"code":401,"indent":0,"parameters":["she ends up hating him in the process.  "]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"Emilia Daily 3 18a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["He’ll keep what he cares about close, even if he has to grab onto "]},{"code":401,"indent":0,"parameters":["them so tightly they bruise."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"Emilia Daily 3 19b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["How insecure and pathetic. "]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"Emilia Daily 3 20b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["But moving on from him… Next we’ve got Prisoner 06, Alora Alenius. "]},{"code":401,"indent":0,"parameters":["She’s become quite controversial these days, hm?"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"Emilia Daily 3 21a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Despite her… Recent actions, it was really close with her. You seemed "]},{"code":401,"indent":0,"parameters":["incredibly on the fence when it came to her. "]},{"code":251,"indent":0,"parameters":[]},{"code":235,"indent":0,"parameters":[10]},{"code":221,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[5,"EmiliaAloraVerdict",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[100]},{"code":231,"indent":0,"parameters":[10,"emilianametag",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"Emilia Daily 3 22a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["But eventually it rounded out at a solid 50.6% Corrupt verdict. "]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"Emilia Daily 3 23a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["I suppose now you’ve seen her true colours you can’t forgive her."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"Emilia Daily 3 24a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["It’s hard for me to explain how exactly she feels about it… It’s not "]},{"code":401,"indent":0,"parameters":["like she didn’t expect this outcome, I know for certain she’d be confused "]},{"code":401,"indent":0,"parameters":["if she had gotten worthy."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"Emilia Daily 3 25a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["But even despite knowing this would happen she seems frustrated."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"Emilia Daily 3 26a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["She seems to take the belief she already knew what she did wrong and "]},{"code":401,"indent":0,"parameters":["didn’t need to be punished any further… Despite not really changing "]},{"code":401,"indent":0,"parameters":["her actions, even now. That earpiece is still in her ear."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"Emilia Daily 3 27b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["In her eyes you were all just trying to knock down her chances of "]},{"code":401,"indent":0,"parameters":["escape further, she feels utterly useless and is getting increasingly "]},{"code":401,"indent":0,"parameters":["frustrated at how little she can do to change her circumstances. "]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"Emilia Daily 3 28a","volume":10