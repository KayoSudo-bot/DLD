{"id":1,"name":"EV001","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":121,"indent":0,"parameters":[37,37,0]},{"code":121,"indent":0,"parameters":[41,41,1]},{"code":221,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[100]},{"code":231,"indent":0,"parameters":[5,"Chapter1opener",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"Chapter opening","volume":30,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,2,2]},{"code":401,"indent":0,"parameters":[""]},{"code":251,"indent":0,"parameters":[]},{"code":221,"indent":0,"parameters":[]},{"code":235,"indent":0,"parameters":[5]},{"code":230,"indent":0,"parameters":[100]},{"code":221,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[5,"Emiliacg1",0,0,0,0,100,100,255,0]},{"code":241,"indent":0,"parameters":[{"name":"Emilias theme","volume":15,"pitch":100,"pan":0}]},{"code":222,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[100]},{"code":231,"indent":0,"parameters":[10,"emilianametag",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne1b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["…Welcome back. Been a while, huh?"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne2b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Seems you got the voting thing figured out, so I’ll cut to the point."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne3a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["A lot has changed around here in the last month, all thanks to you."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne4a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Let me catch you up…"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne5a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["We'll start with Prisoner 07, Taka Takahiro."]},{"code":251,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[5,"EmiliaAlt1",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne6b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["You voted him Corrupt, and by a long-shot too. 70.1%, holy shit. You "]},{"code":401,"indent":0,"parameters":["don’t mess around, do you?"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne7a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Did he get under a nerve? Remind you of someone, perhaps?"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne8a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Wellll, since we told him he’s corrupt his sense of self has been "]},{"code":401,"indent":0,"parameters":["completely shattered. He’s like a completely different person."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne9a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["All that confidence has disappeared into thin air, I don’t think he’s "]},{"code":401,"indent":0,"parameters":["going to be okay for a *while.*"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne10a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Doesn’t help that after his crime came to light, his highschool friend "]},{"code":401,"indent":0,"parameters":["Asuga has completely cut him off, totally ignoring him. "]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne11b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Which like, good for her. They deserve wayyy better than his sorry ass."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne12a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Buuuuuut- it means he’s had no one to protect him from a *certain* Prisoner’s "]},{"code":401,"indent":0,"parameters":["harassment, but we’ll get to her later!"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne13b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["For now, how about we check on Prisoner 11- Mint Byrne?"]},{"code":251,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[5,"EmiliaAlt2",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne14a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["And he was judged as Worthy of Redemption, by a landslide 77.5%."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne15b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["What, did you think he felt guilty or something…? You certainly made a "]},{"code":401,"indent":0,"parameters":["lot of assumptions about him-"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne16a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Well, he certainly doesn’t seem *happy* with his vote. If anything he "]},{"code":401,"indent":0,"parameters":["seems lost and confused now. His faith has certainly been shaken."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne17b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Since his verdict he’s completely isolated himself from all but one Prisoner… "]},{"code":401,"indent":0,"parameters":["Ezekiel Elias, who he seems to have formed a close friendship with. "]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne18a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Ezekiel seems to believe Mint is his next ‘Project’ or something. "]},{"code":401,"indent":0,"parameters":["Convinced he can help him be a 'real man'."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne19b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["But who's really helping who here?"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne20b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Most people don’t really think the two are the best for each other, but "]},{"code":401,"indent":0,"parameters":["who’s to say?"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne21b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["There have been other Prisoners who try to reach out to him, especially Ismene "]},{"code":401,"indent":0,"parameters":["in light of his verdict… But he seems stressed by her attempts to connect."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne22b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Speaking of her… It seems you’ve gotten yourself a long-term ally, heh."]},{"code":251,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[5,"EmiliaAlt3",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne23b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Prisoner 08, Ismene Circe, who 61.4% of you judged as Worthy of Redemption-"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne24b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Has been vindicated by her judgement, it’s certainly improved her view "]},{"code":401,"indent":0,"parameters":["of the audience. She believes any judgements you make must be sensible "]},{"code":401,"indent":0,"parameters":["and correct."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne25a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["…And so has taken to reaffirming them in the prison."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne26b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Bolstering anyone else voted as Worthy of Redemption and placing her "]},{"code":401,"indent":0,"parameters":["trust fully in them."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne27a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["…And delivering scrutiny on those deemed as Corrupt."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne28b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Although, of course, right now she only has Taka to bully.  "]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne29b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["I’m sure this attitude shift of hers is sure to last… So try not to make "]},{"code":401,"indent":0,"parameters":["any judgements you’ll regret afterwards? With her around, you certainly "]},{"code":401,"indent":0,"parameters":["can’t go back on what you say."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne30b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["I’m surprised she got such a high Redemption verdict… But everyone was so "]},{"code":401,"indent":0,"parameters":["convinced the professor deserved it."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne31a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["…Did you think you knew why she did it? You seemed so confident. Well, "]},{"code":401,"indent":0,"parameters":["not my issue."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne32a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["I’ll leave you to see all of these *wonderful* results yourself. "]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne33a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["But if you want my word of advice, it might be best to be less forgiving "]},{"code":401,"indent":0,"parameters":["in the future-"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne34b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["They are Ultimates after all."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne35a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["I’m sure you’ll see what I mean soon. "]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaOne36b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Well, I’ll see you later. I’ll leave you to watch them for now, enjoy~"]},{"code":251,"indent":0,"parameters":[]},{"code":235,"indent":0,"parameters":[10]},{"code":230,"indent":0,"parameters":[50]},{"code":221,"indent":0,"parameters":[]},{"code":235,"indent":0,"parameters":[5]},{"code":242,"indent":0,"parameters":[3]},{"code":230,"indent":0,"parameters":[60]},{"code":221,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[5,"LS9",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code"