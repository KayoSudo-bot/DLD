{"id":1,"name":"EV001","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":221,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[95,"LS69",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[100]},{"code":221,"indent":0,"parameters":[]},{"code":235,"indent":0,"parameters":[95]},{"code":230,"indent":0,"parameters":[60]},{"code":101,"indent":0,"parameters":["",0,2,2]},{"code":401,"indent":0,"parameters":["\\c[6]Would you like to save?"]},{"code":102,"indent":0,"parameters":[["Yes","No"],1,0,2,0]},{"code":402,"indent":0,"parameters":[0,"Yes"]},{"code":352,"indent":1,"parameters":[]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[1,"No"]},{"code":0,"indent":1,"parameters":[]},{"code":404,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[95,"Emiliacg1",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":241,"indent":0,"parameters":[{"name":"MononekoTheatre","volume":15,"pitch":100,"pan":0}]},{"code":230,"indent":0,"parameters":[100]},{"code":231,"indent":0,"parameters":[96,"emilianametag",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaDeadly_20a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["I don’t feel good about this all… I’m kinda disappointed, honestly."]},{"code":251,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[96,"mononekonameplate",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"DeadlyBMononeko17","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Huuuuhhh? Why? Double deaths, double the fun!"]},{"code":251,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[96,"emilianametag",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaDeadly_21a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["I don’t know… It’s just-"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaDeadly_22a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["I guess it doesn’t feel the same when someone else set up the death "]},{"code":401,"indent":0,"parameters":["and forced someone to kill them…"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaDeadly_23a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["It kinda removes individual agency, y’know?"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaDeadly_24a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Like, don’t get me wrong, I’m all for a murderer being forced to live "]},{"code":401,"indent":0,"parameters":["on after they’ve killed and actually face the consequences of their"]},{"code":401,"indent":0,"parameters":["actions-"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaDeadly_25a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["But… It’s different when they never intended to kill anyone. I don’t "]},{"code":401,"indent":0,"parameters":["know. It’s weird. Can you really hold them accountable?"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaDeadly_26a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["It just feels like a bit of a cop-out."]},{"code":251,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[96,"mononekonameplate",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"DeadlyBMononeko18","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["That’s just what makes it *so* good! He never asked for this and he’s "]},{"code":401,"indent":0,"parameters":["going to have to live with this for the rest of his time here!"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DeadlyBMononeko19","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["No matter what he does, her death will be on his hands. Oh, I just "]},{"code":401,"indent":0,"parameters":["can’t *wait* to see how he’ll react! "]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DeadlyBMononeko20","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["C’mon, Millie, don’t tell me you’re empathising with Shinku Kutsuki of "]},{"code":401,"indent":0,"parameters":["all people."]},{"code":251,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[96,"emilianametag",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaDeadly_27a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["It’s less about that… It’s just-"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaDeadly_28a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Will her life even have value after this? Did it mean anything? What "]},{"code":401,"indent":0,"parameters":["was it all for?"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaDeadly_29a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["If anything, all this will do is get Shinku pity and sympathy- it’ll "]},{"code":401,"indent":0,"parameters":["be more about him than her."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaDeadly_30a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["…When it’s also kinda messed up for her to make someone unknowingly a "]},{"code":401,"indent":0,"parameters":["killer, but also I can’t help but feel bad for-"]},{"code":251,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[96,"mononekonameplate",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"DeadlyBMononeko21","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Don’t feel bad for them. They’re Ultimates. You hate Ultimates."]},{"code":251,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[96,"emilianametag",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaDeadly_31b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["I know, I know, you don’t need to remind me of all people. "]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaDeadly_32a","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["I guess I just prefer when things are more simple… When it’s just "]},{"code":401,"indent":0,"parameters":["black or white, right or wrong. When it’s messy like this… There’s "]},{"code":401,"indent":0,"parameters":["not really a right answer."]},{"code":251,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[96,"mononekonameplate",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"DeadlyBMononeko22","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Eh, who cares if there’s a right answer or if there’s a wrong answer- "]},{"code":401,"indent":0,"parameters":["all that matters is what it leads to! The end result is just what you get, "]},{"code":401,"indent":0,"parameters":["you have to live with it!"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DeadlyBMononeko23","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["And if it’s entertaining, that’s good enough for me!"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DeadlyBMononeko24","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["You should be happy there’s a trial with *two* victims, those always "]},{"code":401,"indent":0,"parameters":["get viewership to spike up MASSIVELY!"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DeadlyBMononeko25","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Hi new viewers! If you haven’t, you should totally check out the "]},{"code":401,"indent":0,"parameters":["non-murdery bits as well… Yeah, they’re sorta lame, but it’s good "]},{"code":401,"indent":0,"parameters":["for getting the context!"]},{"code":251,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[96,"emilianametag",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaDeadly_33b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["…I guess plugging ourselves is better than plugging our sponsors- "]},{"code":251,"indent":0,"parameters":[]},{"code":235,"indent":0,"parameters":[10]},{"code":221,"indent":0,"parameters":[]},{"code":235,"indent":0,"parameters":[95]},{"code":235,"indent":0,"parameters":[96]},{"code":230,"indent":0,"parameters":[300]},{"code":201,"indent":0,"parameters":[0,128,0,0,0,0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true}],"x":0,"y":0}
