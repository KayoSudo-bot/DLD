50,"indent":0,"parameters":[{"name":"DeadlyBShinku147","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["The killer proceeded to break one of the test tubes to cause flooding "]},{"code":401,"indent":0,"parameters":["in the lab, in an attempt to cover up the blood on the floor."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DeadlyBShinku148","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["This decision was impulsive and sloppy, further evidence that the "]},{"code":401,"indent":0,"parameters":["killer didn’t have the time to think this through properly. "]},{"code":251,"indent":0,"parameters":[]},{"code":235,"indent":0,"parameters":[10]},{"code":232,"indent":0,"parameters":[1,0,0,0,120,-550,100,100,255,0,30,true]},{"code":235,"indent":0,"parameters":[1]},{"code":232,"indent":0,"parameters":[2,0,0,0,120,-460,100,100,255,0,30,true]},{"code":232,"indent":0,"parameters":[2,0,0,0,120,-450,100,100,255,0,10,true]},{"code":232,"indent":0,"parameters":[3,0,0,0,120,30,100,100,255,0,30,true]},{"code":232,"indent":0,"parameters":[3,0,0,0,120,50,100,100,255,0,10,true]},{"code":231,"indent":0,"parameters":[4,"CA2H",0,0,120,624,100,100,255,0]},{"code":232,"indent":0,"parameters":[4,0,0,0,120,540,100,100,255,0,30,true]},{"code":232,"indent":0,"parameters":[4,0,0,0,120,550,100,100,255,0,10,true]},{"code":230,"indent":0,"parameters":[60]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"DeadlyBShinku149","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["After this, the killer wrapped Taka in one of the bedsheets from "]},{"code":401,"indent":0,"parameters":["the beds in the lab to conceal his body."]},{"code":251,"indent":0,"parameters":[]},{"code":250,