,2]},{"code":401,"indent":0,"parameters":["She gathered all the necessary materials to set up her planned "]},{"code":401,"indent":0,"parameters":["contraption… Ropes, weights, the box and a broom."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DeadlyBShinku138","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["She set everything up so that when the door was broken down, the "]},{"code":401,"indent":0,"parameters":["tripwire would cause the box to fall to the group and hoist her up "]},{"code":401,"indent":0,"parameters":["by the neck- killing her."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DeadlyBShinku139","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["She set this all up to cause someone else to murder her, so she’d "]},{"code":401,"indent":0,"parameters":["be able to take her life while helping someone get out through it… "]},{"code":401,"indent":0,"parameters":["Giving meaning to her death."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DeadlyBShinku140","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["But she needed to wait until the morning to fully execute it."]},{"code":251,"indent":0,"parameters":[]},{"code":235,"indent":0,"parameters":[10]},{"code":232,"indent":0,"parameters":[1,0,0,0,120,-460,100,100,255,0,30,true]},{"code":232,"indent":0,"parameters":[1,0,0,0,120,-450,100,100,255,0,10,true]},{"code":232,"indent":0,"parameters":[2,0,0,0,120,30,100,100,255,0,30,true]},{"code":232,"indent":0,"parameters":[2,0,0,0,120,50,100,100,255,0,10,true]},{"code":231,"indent":0,"parameters":[3,"CA2C",0,0,120,624,100,100,255,0]},{"code":232,"indent":0,"parameters":[3,0,0,0,120,540,100,100,255,0,30,true]},{"code":232,"indent":0,"parameters":[3,0,0,0,120,550,100,100,255,0,10,true]},{"code":230,"indent":0,"parameters":[60]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"DeadlyBShinku141","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["The next day, the killer was up early trying to accomplish her dare- "]},{"code":401,"indent":0,"parameters":["which involved her disfiguring herself with Acid."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DeadlyBShinku142","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["In the middle of her attempt, Taka walked in on her and tried to "]},{"code":401,"indent":0,"parameters":["take and destroy her earpiece… For what I assume was a dare. "]},{"code":251,"indent":0,"parameters":[]},{"code":235,"indent":0,"parameters":[10]},{"code":232,"indent":0,"parameters":[1,0,0,0,120,-550,100,100,255,0,30,true]},{"code":235,"indent":0,"parameters":[1]},{"code":232,"indent":0,"parameters":[2,0,0,0,120,-460,100,100,255,0,30,true]},{"code":232,"indent":0,"parameters":[2,0,0,0,120,-450,100,100,255,0,10,true]},{"code":232,"indent":0,"parameters":[3,0,0,0,120,30,100,100,255,0,30,true]},{"code":232,"indent":0,"parameters":[3,0,0,0,120,50,100,100,255,0,10,true]},{"code":231,"indent":0,"parameters":[4,"CA2D",0,0,120,624,100,100,255,0]},{"code":232,"indent":0,"parameters":[4,0,0,0,120,540,100,100,255,0,30,true]},{"code":232,"indent":0,"parameters":[4,0,0,0,120,550,100,100,255,0,10,true]},{"code":230,"indent":0,"parameters":[60]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"DeadlyBShinku143","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["This made the killer freak out and after a small altercation, the "]},{"code":401,"indent":0,"parameters":["acid was poured over Taka- giving him severe acid burns."]},{"code":251,"indent":0,"parameters":[]},{"code":235,"indent":0,"parameters":[10]},{"code":232,"indent":0,"parameters":[2,0,0,0,120,-550,100,100,255,0,30,true]},{"code":235,"indent":0,"parameters":[2]},{"code":232,"indent":0,"parameters":[3,0,0,0,120,-460,100,100,255,0,30,true]},{"code":232,"indent":0,"parameters":[3,0,0,0,120,-450,100,100,255,0,10,true]},{"code":232,"indent":0,"parameters":[4,0,0,0,120,30,100,100,255,0,30,true]},{"code":232,"indent":0,"parameters":[4,0,0,0,120,50,100,100,255,0,10,true]},{"code":230,"indent":0,"parameters":[60]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"DeadlyBShinku144","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["The killer panicked, not wanting to hurt the boy and quickly grabbed "]},{"code":401,"indent":0,"parameters":["something to chemically cauterise the burns before Taka sustained more "]},{"code":401,"indent":0,"parameters":["damage."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"DeadlyBShinku145","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["This also prevented further bloodloss, stopping the room from getting "]},{"code":401,"indent":0,"parameters":["overly messy… But it was already pretty bad by this point. "]},{"code":251,"indent":0,"parameters":[]},{"code":235,"indent":0,"parameters":[10]},{"code":221,"indent":0,"parameters":[]},{"code":235,"indent":0,"parameters":[4]},{"code":235,"indent":0,"parameters":[3]},{"code":235,"indent":0,"parameters":[2]},{"code":222,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[60]},{"code":231,"indent":0,"parameters":[90,"CAAct2",0,0,0,0,100,100,0,0]},{"code":23