{"id":2,"name":"EV002","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":21,"switch1Valid":true,"switch2Id":24,"switch2Valid":true,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Alora placeholder","direction":8,"pattern":1,"characterIndex":0},"list":[{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Shinku2",7,0,2]},{"code":401,"indent":0,"parameters":["Dr Alenius..? What are you doing here of all places?"]},{"code":231,"indent":0,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Alora3",5,0,2]},{"code":401,"indent":0,"parameters":["Ah… Kutsuki. I apologise, my searches are almost over."]},{"code":101,"indent":0,"parameters":["Alora",7,0,2]},{"code":401,"indent":0,"parameters":["I wasn’t expecting to find much in Shatel’s cell, especially considering "]},{"code":401,"indent":0,"parameters":["how much time she spends in Elias’ but…"]},{"code":101,"indent":0,"parameters":["Alora",2,0,2]},{"code":401,"indent":0,"parameters":["I suppose I was just surprised how well maintained this plant is, she’s "]},{"code":401,"indent":0,"parameters":["clearly put a lot of care into it."]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Shinku4",1,0,2]},{"code":401,"indent":0,"parameters":["…That’s a little strange, she isn’t exactly the most careful person- "]},{"code":401,"indent":0,"parameters":["it’s weird that she was so attentive about this."]},{"code":231,"indent":0,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Alora",5,0,2]},{"code":401,"indent":0,"parameters":["…Perhaps I misjudged her."]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Shinku",2,0,2]},{"code":401,"indent":0,"parameters":["…Maybe me too."]},{"code":101,"indent":0,"parameters":["Shinku4",6,0,2]},{"code":401,"indent":0,"parameters":["Anyway, uhm-... How are you feeling about this motive?"]},{"code":231,"indent":0,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Alora",3,0,2]},{"code":401,"indent":0,"parameters":["…I’ll find a way through it."]},{"code":101,"indent":0,"parameters":["Alora",5,0,2]},{"code":401,"indent":0,"parameters":["I just hope that no matter what happens, people will at least have "]},{"code":401,"indent":0,"parameters":["enough faith in me to know I only wish to help."]},{"code":235,"indent":0,"parameters":[10]},{"code":102,"indent":0,"parameters":[["If you want their faith…","Just be careful","I’ll always trust in you"],1,0,1,0]},{"code":402,"indent":0,"parameters":[0,"If you want their faith…"]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku",2,0,2]},{"code":401,"indent":1,"parameters":["You know, Dr Alenius… If you want them to really believe that, there’s "]},{"code":401,"indent":1,"parameters":["one thing you could do."]},{"code":231,"indent":1,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Alora2",7,0,2]},{"code":401,"indent":1,"parameters":["…I couldn’t possibly."]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku2",1,0,2]},{"code":401,"indent":1,"parameters":["But you can’t properly appreciate the future if you’re so stuck in "]},{"code":401,"indent":1,"parameters":["the past, Dr Alenius."]},{"code":231,"indent":1,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Alora",6,0,2]},{"code":401,"indent":1,"parameters":["You should start taking your own words of advice, Kutsuki."]},{"code":235,"indent":1,"parameters":[10]},{"code":123,"indent":1,"parameters":["A",0]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[1,"Just be careful"]},{"code":231,"indent":1,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Alora",3,0,2]},{"code":401,"indent":1,"parameters":["I will be, I’ll approach everything I do with the utmost caution."]},{"code":101,"indent":1,"parameters":["Alora",6,0,2]},{"code":401,"indent":1,"parameters":["I cannot afford to make any errors anymore, I know that."]},{"code":101,"indent":1,"parameters":["Alora3",1,0,2]},{"code":401,"indent":1,"parameters":["…I should return to the cell searches, have a good day, Kutsuki. We "]},{"code":401,"indent":1,"parameters":["can talk later. "]},{"code":235,"indent":1,"parameters":[10]},{"code":123,"indent":1,"parameters":["A",0]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[2,"I’ll always trust in you"]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku3",6,0,2]},{"code":401,"indent":1,"parameters":["No matter what decisions you make, I’ll always trust you have the best "]},{"code":401,"indent":1,"parameters":["intentions in mind. I know you’re not a bad person, Dr Alenius."]},{"code":231,"indent":1,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Alora2",7,0,2]},{"code":401,"indent":1,"parameters":["…Kutsuki-"]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku4",2,0,2]},{"code":401,"indent":1,"parameters":["…It felt horrible when I thought I’d killed Molly, I can’t imagine "]},{"code":401,"indent":1,"parameters":["having to live with that kind of feeling forever."]},{"code":101,"indent":1,"parameters":["Shinku3",5,0,2]},{"code":401,"indent":1,"parameters":["So, even if I can’t do much, I want to make things a little better for "]},{"code":401,"indent":1,"parameters":["you… However I can."]},{"code":101,"indent":1,"parameters":["Shinku2",0,0,2]},{"code":401,"indent":1,"parameters":["And if trusting your judgement here is what will make things easiest "]},{"code":401,"indent":1,"parameters":["for you, then I’ll do it."]},{"code":231,"indent":1,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Alora",7,0,2]},{"code":401,"indent":1,"parameters":["…If you do wish to help-"]},{"code":101,"indent":1,"parameters":["Alora",5,0,2]},{"code":401,"indent":1,"parameters":["Honestly, I… Well, what I’ve been struggling the most with recently is… "]},{"code":401,"indent":1,"parameters":["Loneliness. It’s strange not having him constantly rushing up to me to "]},{"code":401,"indent":1,"parameters":["talk about… Anything, really."]},{"code":101,"indent":1,"parameters":["Alora",2,0,2]},{"code":401,"indent":1,"parameters":["So if you could stay and humour me for a bit, I’d really appreciate "]},{"code":401,"indent":1,"parameters":["that."]},{"code":235,"indent":1,"parameters":[10]},{"code":102,"indent":1,"parameters":[["Of course","Maybe another time?"],1,0,1,0]},{"code":402,"indent":1,"parameters":[0,"Of course"]},{"code":231,"indent":2,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":2,"parameters":["Alora",3,0,2]},{"code":401,"indent":2,"parameters":["Thank you, Kutsuki."]},{"code":231,"indent":2,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":2,"parameters":["Shinku",2,0,2]},{"code":401,"indent":2,"parameters":["I don’t want to leave you alone. "]},{"code":235,"indent":2,"parameters":[10]},{"code":235,"indent":2,"parameters":[10]},{"code":221,"indent":2,"parameters":[]},{"code":230,"indent":2,"parameters":[100]},{"code":222,"indent":2,"parameters":[]},{"code":117,"indent":2,"parameters":[30]},{"code":0,"indent":2,"parameters":[]},{"code":402,"indent":1,"parameters":[1,"Maybe another time?"]},{"code":231,"indent":2,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":2,"parameters":["Alora",3,0,2]},{"code":401,"indent":2,"parameters":["Absolutely, I understand. You’re already giving me more than enough "]},{"code":401,"indent":2,"parameters":["grace. "]},{"code":235,"indent":2,"parameters":[10]},{"code":0,"indent":2,"parameters":[]},{"code":404,"indent":1,"parameters":[]},{"code":0,"indent":1,"parameters":[]},{"code":404,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":21,"switch1Valid":true,"switch2Id":24,"switch2Valid":true,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Alora placeholder","direction":8,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[6](I should leave her be...)"]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":15,"y":10},
{"id":3,"name":"EV003","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":21,"switch1Valid":true,"switch2Id":32,"switch2Valid":true,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Lyly","direction":2,"pattern":1,"characterIndex":0},"list":[{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Shinku3",5,0,2]},{"code":401,"indent":0,"parameters":["Lyra… I wanted to thank you for last night."]},{"code":231,"indent":0,"parameters":[10,"Lyranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Lyra",0,0,2]},{"code":401,"indent":0,"parameters":["No worries, don’t even mention it. "]},{"code":101,"indent":0,"parameters":["Lyra4",6,0,2]},{"code":401,"indent":0,"parameters":["You uh… Feeling good after all that? It was pretty heavy…"]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Shinku",2,0,2]},{"code":401,"indent":0,"parameters":["Yeah, I’m feeling completely different honestly… It’s not bad or "]},{"code":401,"indent":0,"parameters":["good, it’s just a change. "]},{"code":231,"indent":0,"parameters":[10,"Lyranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Lyra3",5,0,2]},{"code":401,"indent":0,"parameters":["Not as big of a deal as you expected though, is it? It’s a lot more "]},{"code":401,"indent":0,"parameters":["quiet, least from what I remember."]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Shinku",2,0,2]},{"code":401,"indent":0,"parameters":["…You don’t make much sense."]},{"code":231,"indent":0,"parameters":[10,"Lyranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Lyra",1,0,2]},{"code":401,"indent":0,"parameters":["Eh, maybe I don’t. "]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Shinku4",1,0,2]},{"code":401,"indent":0,"parameters":["I’m just a little confused why you went out of your way like that-"]},{"code":231,"indent":0,"parameters":[10,"Lyranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Lyra3",5,0,2]},{"code":401,"indent":0,"parameters":["…Guess I didn’t want to feel alone, I don’t think that’s a crime- "]},{"code":401,"indent":0,"parameters":["is it? "]},{"code":235,"indent":0,"parameters":[10]},{"code":102,"indent":0,"parameters":[["Did you ever stop feeling alone?","I just thought it would feel bigger","Is that all?"],1,0,1,0]},{"code":402,"indent":0,"parameters":[0,"Did you ever stop feeling alone?"]},{"code":231,"indent":1,"parameters":[10,"Lyranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Lyra3",6,0,2]},{"code":401,"indent":1,"parameters":["…Huh?"]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku3",7,0,2]},{"code":401,"indent":1,"parameters":["Those things you were saying… That didn’t come from a place of "]},{"code":401,"indent":1,"parameters":["inexperience, did it?"]},{"code":231,"indent":1,"parameters":[10,"Lyranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Lyra4",4,0,2]},{"code":401,"indent":1,"parameters":["..."]},{"code":101,"indent":1,"parameters":["Lyra4",2,0,2]},{"code":401,"indent":1,"parameters":["I didn’t notice how lonely I’d really been until I stopped being alone."]},{"code":101,"indent":1,"parameters":["Lyra3",5,0,2]},{"code":401,"indent":1,"parameters":["For the first time, I’ve got people I actually care about-"]},{"code":101,"indent":1,"parameters":["Lyra2",3,0,2]},{"code":401,"indent":1,"parameters":["It’s weird, really, I feel so connected to them and yet so distant… "]},{"code":401,"indent":1,"parameters":["Like I’m on a different planet from them constantly."]},{"code":101,"indent":1,"parameters":["Lyra4",4,0,2]},{"code":401,"indent":1,"parameters":["Maybe everyone feels this way and I’m only just starting to feel normal… "]},{"code":401,"indent":1,"parameters":["Or maybe I’ve been the abnormal one all along-"]},{"code":101,"indent":1,"parameters":["Lyra4",2,0,2]},{"code":401,"indent":1,"parameters":["…Maybe I’m still lonely, unable to fully let my barriers down even "]},{"code":401,"indent":1,"parameters":["with the people I do care about- maybe that makes it more terrifying."]},{"code":101,"indent":1,"parameters":["Lyra4",4,0,2]},{"code":401,"indent":1,"parameters":["There’s a lot I can say, all of it could be true or maybe none of "]},{"code":401,"indent":1,"parameters":["it is true…"]},{"code":101,"indent":1,"parameters":["Lyra3",5,0,2]},{"code":401,"indent":1,"parameters":["All I know now is I need to figure it out, day by day, step by step. "]},{"code":401,"indent":1,"parameters":["But I don’t think that’s going to fully be achieved alone, just being "]},{"code":401,"indent":1,"parameters":["up in my own head."]},{"code":101,"indent":1,"parameters":["Lyra",0,0,2]},{"code":401,"indent":1,"parameters":["I think through understanding others, you can kind of start to get a "]},{"code":401,"indent":1,"parameters":["better idea of yourself… Even if the experiences aren’t always positive."]},{"code":101,"indent":1,"parameters":["Lyra",6,0,2]},{"code":401,"indent":1,"parameters":["So, if you’d like Shinku- you’re free to stay here and hang out with "]},{"code":401,"indent":1,"parameters":["me now. It might help the both of us figure out what the hell our "]},{"code":401,"indent":1,"parameters":["problem is, y’know?"]},{"code":235,"indent":1,"parameters":[10]},{"code":102,"indent":1,"parameters":[["I'd like that","Maybe another time"],1,0,1,0]},{"code":402,"indent":1,"parameters":[0,"I'd like that"]},{"code":231,"indent":2,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":2,"parameters":["Shinku",2,0,2]},{"code":401,"indent":2,"parameters":["I think… We could both use that right now."]},{"code":231,"indent":2,"parameters":[10,"Lyranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":2,"parameters":["Lyra4",6,0,2]},{"code":401,"indent":2,"parameters":["I agree. "]},{"code":235,"indent":2,"parameters":[10]},{"code":221,"indent":2,"parameters":[]},{"code":230,"indent":2,"parameters":[100]},{"code":222,"indent":2,"parameters":[]},{"code":117,"indent":2,"parameters":[106]},{"code":0,"indent":2,"parameters":[]},{"code":402,"indent":1,"parameters":[1,"Maybe another time"]},{"code":231,"indent":2,"parameters":[10,"Lyranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":2,"parameters":["Lyra",1,0,2]},{"code":401,"indent":2,"parameters":["All good, take it easy- alright? "]},{"code":235,"indent":2,"parameters":[10]},{"code":0,"indent":2,"parameters":[]},{"code":404,"indent":1,"parameters":[]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[1,"I just thought it would feel bigger"]},{"code":231,"indent":1,"parameters":[10,"Lyranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Lyra2",0,0,2]},{"code":401,"indent":1,"parameters":["It’s not really as life changing as people say it is."]},{"code":101,"indent":1,"parameters":["Lyra2",3,0,2]},{"code":401,"indent":1,"parameters":["At the end of the day you’re just setting yourself up for failure if "]},{"code":401,"indent":1,"parameters":["you imagine it as the big life changing thing… Or maybe I’m just "]},{"code":401,"indent":1,"parameters":["messed up, maybe nothing ever felt all that important to me."]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku4",2,0,2]},{"code":401,"indent":1,"parameters":["I think I need to really think about what is important to me."]},{"code":231,"indent":1,"parameters":[10,"Lyranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Lyra3",5,0,2]},{"code":401,"indent":1,"parameters":["When you find it, chase it. Just start chasing immediately, else "]},{"code":401,"indent":1,"parameters":["you’ll end up regretting not doing it sooner. "]},{"code":101,"indent":1,"parameters":["Lyra3",1,0,2]},{"code":401,"indent":1,"parameters":["Don’t get caught in a net of your own bs, that’s stupid as hell…"]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku",2,0,2]},{"code":401,"indent":1,"parameters":["Don’t be too harsh on yourself…"]},{"code":231,"indent":1,"parameters":[10,"Lyranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Lyra3",6,0,2]},{"code":401,"indent":1,"parameters":["…Wow, okay."]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku2",4,0,2]},{"code":401,"indent":1,"parameters":["I didn’t mean-"]},{"code":231,"indent":1,"parameters":[10,"Lyranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Lyra4",6,0,2]},{"code":401,"indent":1,"parameters":["It’s all good… I know you’re right. "]},{"code":235,"indent":1,"parameters":[10]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["\\c[6](Despite those words she seemed a little colder again… I think "]},{"code":401,"indent":1,"parameters":["I said something wrong.)"]},{"code":123,"indent":1,"parameters":["A",0]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[2,"Is that all?"]},{"code":231,"indent":1,"parameters":[10,"Lyranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Lyra2",0,0,2]},{"code":401,"indent":1,"parameters":["Yeah? What? It is as simple as that-"]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku2",5,0,2]},{"code":401,"indent":1,"parameters":["It just felt…"]},{"code":231,"indent":1,"parameters":[10,"Lyranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Lyra3",1,0,2]},{"code":401,"indent":1,"parameters":["What? Do you want me to say I’m in *love* with you or something? "]},{"code":401,"indent":1,"parameters":["Get out of your own ass, I’m not."]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku3",3,0,2]},{"code":401,"indent":1,"parameters":["Wh- no-"]},{"code":231,"indent":1,"parameters":[10,"Lyranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Lyra2",1,0,2]},{"code":401,"indent":1,"parameters":["Yeahyeah, whatever you say. "]},{"code":235,"indent":1,"parameters":[10]},{"code":123,"indent":1,"parameters":["A",0]},{"code":0,"indent":1,"parameters":[]},{"code":404,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":21,"switch1Valid":true,"switch2Id":32,"switch2Valid":true,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Lyly","direction":2,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[6](I don't think she wants to talk to me right now...)"]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":6,"y":10},
