{"id":16,"name":"EV016","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":22,"switch1Valid":true,"switch2Id":21,"switch2Valid":true,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"takik","direction":8,"pattern":1,"characterIndex":0},"list":[{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Shinku3",7,0,2]},{"code":401,"indent":0,"parameters":["Takiko..? What are you doing here?"]},{"code":231,"indent":0,"parameters":[10,"Takikonameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Takiko4",5,0,2]},{"code":401,"indent":0,"parameters":["Hm? Oh… Shinku."]},{"code":101,"indent":0,"parameters":["Takiko2",0,0,2]},{"code":401,"indent":0,"parameters":["Nothing, I’m not really religious… I guess I just wanted to go "]},{"code":401,"indent":0,"parameters":["somewhere quiet."]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Shinku3",6,0,2]},{"code":401,"indent":0,"parameters":["The statues here are nice, aren’t they?"]},{"code":231,"indent":0,"parameters":[10,"Takikonameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Takiko2",5,0,2]},{"code":401,"indent":0,"parameters":["…Angels… That’s what Molly wanted to become, isn’t it?"]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Shinku4",6,0,2]},{"code":401,"indent":0,"parameters":["..."]},{"code":231,"indent":0,"parameters":[10,"Takikonameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Takiko5",5,0,2]},{"code":401,"indent":0,"parameters":["People have this idea angels are meant to be pure, devoid of ill-intent, "]},{"code":401,"indent":0,"parameters":["perfect and flawless-"]},{"code":101,"indent":0,"parameters":["Takiko5",2,0,2]},{"code":401,"indent":0,"parameters":["Because they’re meant to be above human vices."]},{"code":101,"indent":0,"parameters":["Takiko4",3,0,2]},{"code":401,"indent":0,"parameters":["But in reality angels are destructive, ruthless and beyond all human "]},{"code":401,"indent":0,"parameters":["emotions… Including empathy. "]},{"code":101,"indent":0,"parameters":["Takiko2",4,0,2]},{"code":401,"indent":0,"parameters":["I wonder if she wanted to become one to be above everything… I think "]},{"code":401,"indent":0,"parameters":["she just wanted to stop feeling anything. I get that."]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Shinku2",1,0,2]},{"code":401,"indent":0,"parameters":["I think we probably shouldn’t speculate on that sort of thing, it seems"]},{"code":401,"indent":0,"parameters":["distasteful…"]},{"code":231,"indent":0,"parameters":[10,"Takikonameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Takiko5",1,0,2]},{"code":401,"indent":0,"parameters":["..."]},{"code":101,"indent":0,"parameters":["Takiko5",3,0,2]},{"code":401,"indent":0,"parameters":["If you ask me, I think it was one of those cases where she didn’t "]},{"code":401,"indent":0,"parameters":["want to die- she just wanted to disappear. "]},{"code":101,"indent":0,"parameters":["Takiko2",4,0,2]},{"code":401,"indent":0,"parameters":["Do you get what I mean..?"]},{"code":235,"indent":0,"parameters":[10]},{"code":102,"indent":0,"parameters":[["...","I understand it.","But she tried to die."],1,0,1,0]},{"code":402,"indent":0,"parameters":[0,"..."]},{"code":231,"indent":1,"parameters":[10,"Takikonameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Takiko",1,0,2]},{"code":401,"indent":1,"parameters":["…I guess I’m just speaking nonsense."]},{"code":101,"indent":1,"parameters":["Takiko5",3,0,2]},{"code":401,"indent":1,"parameters":["Sorry for bothering you."]},{"code":235,"indent":1,"parameters":[10]},{"code":123,"indent":1,"parameters":["A",0]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[1,"I understand it."]},{"code":231,"indent":1,"parameters":[10,"Takikonameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Takiko4",4,0,2]},{"code":401,"indent":1,"parameters":["…Of course you do."]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku2",4,0,2]},{"code":401,"indent":1,"parameters":["What’s that meant to mean?"]},{"code":231,"indent":1,"parameters":[10,"Takikonameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Takiko",0,0,2]},{"code":401,"indent":1,"parameters":["I think everyone feels that way… But in the end you have to live with "]},{"code":401,"indent":1,"parameters":["whoever you are, you can’t disappear. You just have to find ways to make "]},{"code":401,"indent":1,"parameters":["life livable for yourself."]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku3",7,0,2]},{"code":401,"indent":1,"parameters":["…Is that why you did what you did?"]},{"code":231,"indent":1,"parameters":[10,"Takikonameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Takiko",1,0,2]},{"code":401,"indent":1,"parameters":["…Would you have preferred I reached my breaking point?"]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku4",6,0,2]},{"code":401,"indent":1,"parameters":["No, absolutely not. "]},{"code":235,"indent":1,"parameters":[10]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["\\c[6](Takiko seemed a little stunned at how quickly I responded.)"]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku",7,0,2]},{"code":401,"indent":1,"parameters":["Look, I don’t agree with or understand your crime… It seems incredibly "]},{"code":401,"indent":1,"parameters":["cruel to me. But-"]},{"code":101,"indent":1,"parameters":["Shinku",0,0,2]},{"code":401,"indent":1,"parameters":["…No matter how cruel you were, I’m glad you’re alive."]},{"code":231,"indent":1,"parameters":[10,"Takikonameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Takiko",6,0,2]},{"code":401,"indent":1,"parameters":["..."]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku2",0,0,2]},{"code":401,"indent":1,"parameters":["…When you are doing well you can brighten up so many people’s days "]},{"code":401,"indent":1,"parameters":["and I know you’ve gotten others through some tough times."]},{"code":101,"indent":1,"parameters":["Shinku3",6,0,2]},{"code":401,"indent":1,"parameters":["If you weren’t alive I’m sure things would be a lot worse for a "]},{"code":401,"indent":1,"parameters":["lot of people."]},{"code":231,"indent":1,"parameters":[10,"Takikonameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Takiko4",3,0,2]},{"code":401,"indent":1,"parameters":["…I didn’t know you found talking to me that important."]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku4",1,0,2]},{"code":401,"indent":1,"parameters":["If I’m honest, it’s been a little tricky going without it for so "]},{"code":401,"indent":1,"parameters":["long-"]},{"code":101,"indent":1,"parameters":["Shinku",2,0,2]},{"code":401,"indent":1,"parameters":["I know you’re going through a lot right now, but I hope you can grow "]},{"code":401,"indent":1,"parameters":["to a point where you feel comfortable being happy again… I miss "]},{"code":401,"indent":1,"parameters":["talking to you."]},{"code":235,"indent":1,"parameters":[10]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent"