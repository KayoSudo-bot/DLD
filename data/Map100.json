{"id":12,"name":"EV012","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":21,"switch1Valid":true,"switch2Id":24,"switch2Valid":true,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"taka","direction":8,"pattern":1,"characterIndex":0},"list":[{"code":231,"indent":0,"parameters":[10,"Takanameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Taka4",0,0,2]},{"code":401,"indent":0,"parameters":["Shinku… I’m fried! I’m absolutely cooked! It’s so Takaover! "]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Shinku2",4,0,2]},{"code":401,"indent":0,"parameters":["Woah, woah, woah- slow down… What’s up?"]},{"code":231,"indent":0,"parameters":[10,"Takanameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Taka3",2,0,2]},{"code":401,"indent":0,"parameters":["Uhm… Alora asked me to take stock of all the medicines so she knew exactly "]},{"code":401,"indent":0,"parameters":["how to ration things out if the Truth or Dare thing caused injuries but-"]},{"code":101,"indent":0,"parameters":["Taka3",4,0,2]},{"code":401,"indent":0,"parameters":["I might have made a small little oopsie."]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Shinku2",7,0,2]},{"code":401,"indent":0,"parameters":["How so?"]},{"code":231,"indent":0,"parameters":[10,"Takanameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Taka",6,0,2]},{"code":401,"indent":0,"parameters":["A load of the painkillers are GONE! Vanished! Away with the wind! "]},{"code":401,"indent":0,"parameters":["Someone’s gone and absconded with them!"]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Shinku4",2,0,2]},{"code":401,"indent":0,"parameters":["What..? How did that happen?"]},{"code":231,"indent":0,"parameters":[10,"Takanameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Taka",3,0,2]},{"code":401,"indent":0,"parameters":["I don’t know! I just don’t want Lori to get mad at me, I might get my "]},{"code":401,"indent":0,"parameters":["Taka Treat Tuesdays revoked!!"]},{"code":235,"indent":0,"parameters":[10]},{"code":102,"indent":0,"parameters":[["Taka Treat Tuesdays???","She won’t hate you.","Did someone take them? "],1,0,1,0]},{"code":402,"indent":0,"parameters":[0,"Taka Treat Tuesdays???"]},{"code":231,"indent":1,"parameters":[10,"Takanameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Taka2",6,0,2]},{"code":401,"indent":1,"parameters":["OH! Uhm, well-"]},{"code":101,"indent":1,"parameters":["Taka3",4,0,2]},{"code":401,"indent":1,"parameters":["If I work really, really hard throughout the week she gives me a little "]},{"code":401,"indent":1,"parameters":["treat on my usual dinner tray once a week. "]},{"code":101,"indent":1,"parameters":["Taka3",7,0,2]},{"code":401,"indent":1,"parameters":["She doesn’t do it for any of the others, so don’t tell them because they "]},{"code":401,"indent":1,"parameters":["might get jealous that *I’m* the favourite. "]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku",2,0,2]},{"code":401,"indent":1,"parameters":["…I think that’s pretty obvious quite frankly."]},{"code":231,"indent":1,"parameters":[10,"Takanameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Taka2",1,0,2]},{"code":401,"indent":1,"parameters":["Well, I was her *first* lab assistant so, it’s only natural I’m the best."]},{"code":101,"indent":1,"parameters":["Taka2",4,0,2]},{"code":401,"indent":1,"parameters":["…But! If I want it this week I have to work super hard, so I’m going to "]},{"code":401,"indent":1,"parameters":["need to lock-in and get to the bottom of this! "]},{"code":101,"indent":1,"parameters":["Taka2",1,0,2]},{"code":401,"indent":1,"parameters":["I’ll figure out who took all these painkillers, just you wait!"]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku",2,0,2]},{"code":401,"indent":1,"parameters":["Well… Good Luck with that."]},{"code":235,"indent":1,"parameters":[10]},{"code":123,"indent":1,"parameters":["A",0]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[1,"She won’t hate you."]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku3",7,0,2]},{"code":401,"indent":1,"parameters":["I can promise you, Taka. She won’t hate you, this wasn’t your fault."]},{"code":231,"indent":1,"parameters":[10,"Takanameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Taka3",2,0,2]},{"code":401,"indent":1,"parameters":["Still… She’s done so much for me and she just keeps on taking more and "]},{"code":401,"indent":1,"parameters":["more jobs onto herself… "]},{"code":101,"indent":1,"parameters":["Taka2",3,0,2]},{"code":401,"indent":1,"parameters":["I don’t want her to have to worry about someone stealing the medicine on "]},{"code":401,"indent":1,"parameters":["top of everything else on her plate right now! "]},{"code":101,"indent":1,"parameters":["Taka2",0,0,2]},{"code":401,"indent":1,"parameters":["I have to figure this out, no matter what!"]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku2",0,0,2]},{"code":401,"indent":1,"parameters":["…Well, if you’d like we could stay here and guard for a few hours to "]},{"code":401,"indent":1,"parameters":["see if anyone comes in to get anything else?"]},{"code":231,"indent":1,"parameters":[10,"Takanameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Taka3",6,0,2]},{"code":401,"indent":1,"parameters":["Wait! That’s a really good idea! Are you sure you’d be happy doing that?"]},{"code":401,"indent":1,"parameters":["For real?"]},{"code":235,"indent":1,"parameters":[10]},{"code":102,"indent":1,"parameters":[["Yes","No"],1,0,1,0]},{"code":402,"indent":1,"parameters":[0,"Yes"]},{"code":231,"indent":2,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":2,"parameters":["Shinku3",6,0,2]},{"code":401,"indent":2,"parameters":["Of course, I’ve not got much else to do."]},{"code":231,"indent":2,"parameters":[10,"Takanameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":2,"parameters":["Taka2",7,0,2]},{"code":401,"indent":2,"parameters":["Great! We’ll get to the bottom of this, no matter what-!"]},{"code":101,"indent":2,"parameters":["Taka2",1,0,2]},{"code":401,"indent":2,"parameters":["…But until our thief shows their little RAT face, let’s chat!"]},{"code":235,"indent":2,"parameters":[10]},{"code":235,"indent":2,"parameters":[10]},{"code":221,"indent":2,"parameters":[]},{"code":230,"indent":2,"parameters":[100]},{"code":222,"indent":2,"parameters":[]},{"code":117,"indent":2,"parameters":[79]},{"code":0,"indent":2,"parameters":[]},{"code":402,"indent":1,"parameters":[1,"No"]},{"code":231,"indent":2,"parameters":[10,"Takanameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":2,"parameters":["Taka2",0,0,2]},{"code":401,"indent":2,"parameters":["…Then why did you offer in the first place???? Hmph! "]},{"code":235,"indent":2,"parameters":[10]},{"code":0,"indent":2,"parameters":[]},{"code":404,"indent":1,"parameters":[]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[2,"Did someone take them? "]},{"code":231,"indent":1,"parameters":[10,"Takanameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Taka3",2,0,2]},{"code":401,"indent":1,"parameters":["…I’m not sure, that’s what I’m guessing-"]},{"code":101,"indent":1,"parameters":["Taka3",4,0,2]},{"code":401,"indent":1,"parameters"