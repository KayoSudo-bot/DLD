arameters":["things safe… That’s the sorta thing that’ll get ya eaten alive by "]},{"code":401,"indent":1,"parameters":["this motive."]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku2",1,0,2]},{"code":401,"indent":1,"parameters":["Rather be eaten alive than drink myself to death."]},{"code":231,"indent":1,"parameters":[10,"Funameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["MMFu",1,0,2]},{"code":401,"indent":1,"parameters":["Heh, to each their own. "]},{"code":235,"indent":1,"parameters":[10]},{"code":123,"indent":1,"parameters":["A",0]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[1,"Just one"]},{"code":231,"indent":1,"parameters":[10,"Funameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["MMFu",5,0,2]},{"code":401,"indent":1,"parameters":["Heh, now we’re talking- here, it’ll help you take the edge off."]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku",3,0,2]},{"code":401,"indent":1,"parameters":["Don’t you want me to be on edge?"]},{"code":231,"indent":1,"parameters":[10,"Funameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["MMFu",2,0,2]},{"code":401,"indent":1,"parameters":["Eh, well, drinking will make you stupid- and I think you’re more funny "]},{"code":401,"indent":1,"parameters":["when you’re being stupid, or honest."]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku",5,0,2]},{"code":401,"indent":1,"parameters":["…Maybe I don’t actually want a drink."]},{"code":231,"indent":1,"parameters":[10,"Funameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["MMFu2",0,0,2]},{"code":401,"indent":1,"parameters":["Too late, already poured it- you don’t want to waste it, do you? "]},{"code":401,"indent":1,"parameters":["‘Sides, it’s only a double of amaretto, it’s hardly anything."]},{"code":101,"indent":1,"parameters":["MMFu3",2,0,2]},{"code":401,"indent":1,"parameters":["Here, I’ll make it up to you- stay a while and drink, we can talk. "]},{"code":401,"indent":1,"parameters":["Who knows? I might be able to give you some tips for this motive, "]},{"code":401,"indent":1,"parameters":["just ‘cuz I like ya. Wanna keep you around a bit longer, you’re fun "]},{"code":401,"indent":1,"parameters":["to mess with."]},{"code":235,"indent":1,"parameters":[10]},{"code":102,"indent":1,"parameters":[["...Fine","Absolutely not"],1,0,1,0]},{"code":402,"indent":1,"parameters":[0,"...Fine"]},{"code":231,"indent":2,"parameters":[10,"Funameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":2,"parameters":["MMFu2",5,0,2]},{"code":401,"indent":2,"parameters":["Heh, maybe you do have some guts, kid."]},{"code":235,"indent":2,"parameters":[10]},{"code":235,"indent":2,"parameters":[10]},{"code":221,"indent":2,"parameters":[]},{"code":230,"indent":2,"parameters":[100]},{"code":222,"indent":2,"parameters":[]},{"code":117,"indent":2,"parameters":[32]},{"code":0,"indent":2,"parameters":[]},{"code":402,"indent":1,"parameters":[1,"Absolutely not"]},{"code":231,"indent":2,"parameters":[10,"Funameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":2,"parameters":["MMFu2",5,0,2]},{"code":401,"indent":2,"parameters":["Your loss."]},{"code":235,"indent":2,"parameters":[10]},{"code":0,"indent":2,"parameters":[]},{"code":404,"indent":1,"parameters":[]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[2,"We can't go back to old times"]},{"code":231,"indent":1,"parameters":[10,"Funameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["MMFu2",4,0,2]},{"code":401,"indent":1,"parameters":["…Ha… S’ppose not. "]},{"code":101,"indent":1,"parameters":["MMFu2",0,0,2]},{"code":401,"indent":1,"parameters":["Maybe I’m just nostalgic… But I mean, I can still mess with ya no "]},{"code":401,"indent":1,"parameters":["matter how you feel about me."]},{"code":101,"indent":1,"parameters":["MMFu3",3,0,2]},{"code":401,"indent":1,"parameters":["Not like we were ever particularly that close, huh?"]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku",3,0,2]},{"code":401,"indent":1,"parameters":["Guess I dodged a bullet there."]},{"code":231,"indent":1,"parameters":[10,"Funameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["MMFu2",4,0,2]},{"code":401,"indent":1,"parameters":["Hard to dodge something I didn’t even fire in the first place, kid. "]},{"code":235,"indent":1,"parameters":[10]},{"code":123,"indent":1,"parameters":["A",0]},{"code":0,"indent":1,"parameters":[]},{"code":404,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":24,"switch1Valid":true,"switch2Id":21,"switch2Valid":true,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"fu","direction":6,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[6](I don't want to drink with Fu right now...)"]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":3,"y":7},
{"id":14,"name":"EV014","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":26,"switch1Valid":true,"switch2Id":21,"switch2Valid":true,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Alora placeholder","direction":8,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[6](Dr Alenius was busy pursuing and noting various numbers on a large "]},{"code":401,"indent":0,"parameters":["spreadsheet she’d laid out, tapping her pen to her chin- extremely focused.)"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[6](I felt like I shouldn’t disturb her, but as I went to leave-)"]},{"code":231,"indent":0,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Alora3",5,0,2]},{"code":401,"indent":0,"parameters":["Ah, Kutsuki, perhaps you could help me-"]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Shinku2",4,0,2]},{"code":401,"indent":0,"parameters":["Huh..?"]},{"code":231,"indent":0,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Alora2",3,0,2]},{"code":401,"indent":0,"parameters":["I’m currently sorting out the ration plan from here on out, we’ll be "]},{"code":401,"indent":0,"parameters":["able to live for a while… Whether we’ll be comfortable is another "]},{"code":401,"indent":0,"parameters":["question."]},{"code":101,"indent":0,"parameters":["Alora",7,0,2]},{"code":401,"indent":0,"parameters":["But would you rather have one week of satiation and a month of starvation?"]},{"code":101,"indent":0,"parameters":["Alora3",5,0,2]},{"code":401,"indent":0,"parameters":["Or the same amount of time but feeling a mild level of hunger or "]},{"code":401,"indent":0,"parameters":["dissatisfaction the entire duration?"]},{"code":235,"indent":0,"parameters":[10]},{"code":102,"indent":0,"parameters":[["The First","The Second","Both don't sound ideal"],1,0,1,0]},{"code":402,"indent":0,"parameters":[0,"The First"]},{"code":231,"indent":1,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Alora2",6,0,2]},{"code":401,"indent":1,"parameters":["…Really? You’d be fine with prolonged suffering if it meant you were "]},{"code":401,"indent":1,"parameters":["allowed one last normal week?"]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku4",2,0,2]},{"code":401,"indent":1,"parameters":["…We don’t tend to last more than a week once a motive gets introduced "]},{"code":401,"indent":1,"parameters":["anyway."]},{"code":231,"indent":1,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Alora",6,0,2]},{"code":401,"indent":1,"parameters":["Well, it’ll be different this time, I’m certain."]},{"code":101,"indent":1,"parameters":["Alora",7,0,2]},{"code":401,"indent":1,"parameters":["…But if you feel that way it’s likely the others feel the same."]},{"code":101,"indent":1,"parameters":["Alora",3,0,2]},{"code":401,"indent":1,"parameters":["…I should readjust my plan-"]},{"code":235,"indent":1,"parameters":[10]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["\\c[6](Dr Alenius looked back down at her spreadsheet and returned to "]},{"code":401,"indent":1,"parameters":["quiet contemplation, I felt I should leave her to her work.)"]},{"code":123,"indent":1,"parameters":["A",0]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[1,"The Second"]},{"code":231,"indent":1,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Alora2",3,0,2]},{"code":401,"indent":1,"parameters":["Precisely… I believed that would be better than the alternatives."]},{"code":101,"indent":1,"parameters":["Alora",6,0,2]},{"code":401,"indent":1,"parameters":["Ideally we’ll get to a stage of food production where we can continuously "]},{"code":401,"indent":1,"parameters":["be satiated, but until that point it’s better to be unsatisfied than to "]},{"code":401,"indent":1,"parameters":["starve."]},{"code":101,"indent":1,"parameters":["Alora",3,0,2]},{"code":401,"indent":1,"parameters":["…And if you feel that way it’s likely the others do too, which is "]},{"code":401,"indent":1,"parameters":["relieving. "]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku3",5,0,2]},{"code":401,"indent":1,"parameters":["Don’t stress too much, I’m sure whatever plan you have it’ll work out "]},{"code":401,"indent":1,"parameters":["how it’s meant to."]},{"code":231,"indent":1,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Alora4",4,0,2]},{"code":401,"indent":1,"parameters":["I suppose I am stressing myself out a bit thinking in circles… "]},{"code":401,"indent":1,"parameters":["A break might be what I need to refresh my mind and think of better "]},{"code":401,"indent":1,"parameters":["ways to maximise what we have."]},{"code":101,"indent":1,"parameters":["Alora",2,0,2]},{"code":401,"indent":1,"parameters":["If you’d like, Kutsuki. You’re free to stay and talk, I think it could "]},{"code":401,"indent":1,"parameters":["do the both of us some good."]},{"code":235,"indent":1,"parameters":[10]},{"code":102,"indent":1,"parameters":[["Sure","Maybe later"],1,0,1,0]},{"code":402,"indent":1,"parameters":[0,"Sure"]},{"code":231,"indent":2,"parameters":[10,"Aloranameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":2,"parameters":["Alora2",2,0,2]},{"code":401,"indent":2,"parameters":["Wonderful."]},{"code":235,"indent":2,"parameters":[10]},{"code":235,"indent":2,"parameters":