{"id":3,"name":"EV003","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":111,"indent":0,"parameters":[0,168,0]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["\\c[6](Low and behold the cat was actually here for once, it was almost "]},{"code":401,"indent":1,"parameters":["like they’d overheard my previous conversation with Lyra and was "]},{"code":401,"indent":1,"parameters":["trying to capitalise off of it.)"]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["\\c[6](As they saw me approach, Mononeko let out a purr and swished their "]},{"code":401,"indent":1,"parameters":["tail.)"]},{"code":231,"indent":1,"parameters":[10,"mononekonameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Mononeko2",1,0,2]},{"code":401,"indent":1,"parameters":["Helllllloooo, Shinku~ "]},{"code":101,"indent":1,"parameters":["Mononeko",7,0,2]},{"code":401,"indent":1,"parameters":["Looking for anything in particular, by any chance?"]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku",7,0,2]},{"code":401,"indent":1,"parameters":["Do you have any old VHSes or just tapes we could play? Anything that could "]},{"code":401,"indent":1,"parameters":["be projected?"]},{"code":231,"indent":1,"parameters":[10,"mononekonameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Mononeko",2,0,2]},{"code":401,"indent":1,"parameters":["Why of course! We’ve got a whole *bunch* of old tapes from back in "]},{"code":401,"indent":1,"parameters":["the day, anything your heart desires!"]},{"code":101,"indent":1,"parameters":["Mononeko2",0,0,2]},{"code":401,"indent":1,"parameters":["…As long as that anything just so happens to fit into the like, six "]},{"code":401,"indent":1,"parameters":["movies we have-"]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku3",1,0,2]},{"code":401,"indent":1,"parameters":["Wait, really-? That’s great! Do you have any recommendations? Or maybe… "]},{"code":401,"indent":1,"parameters":["I’ll just take all six! It’ll be better if we’ve got a choice."]},{"code":231,"indent":1,"parameters":[10,"mononekonameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Mononeko",4,0,2]},{"code":401,"indent":1,"parameters":["Hold on- do you think I’m just going to *give* them to you? Nonono, "]},{"code":401,"indent":1,"parameters":["that’s not how this works! I’ve got a business here! I’ve got kids "]},{"code":401,"indent":1,"parameters":["to feed, don’t you know?"]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku4",6,0,2]},{"code":401,"indent":1,"parameters":["…Kids? Mononeko, you’re a robo-"]},{"code":231,"indent":1,"parameters":[10,"mononekonameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Mononeko2",4,0,2]},{"code":401,"indent":1,"parameters":["You want them to STARVE, huh? It’s big shots like you who refuse to shop "]},{"code":401,"indent":1,"parameters":["at local businesses and expect charity from them that are helping big "]},{"code":401,"indent":1,"parameters":["corporations take up more and more of the market share! "]},{"code":101,"indent":1,"parameters":["Mononeko",4,0,2]},{"code":401,"indent":1,"parameters":["People like *you* are the reason late stage capitalism is becoming current "]},{"code":401,"indent":1,"parameters":["stage capitalism, don’t ya know?"]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku3",4,0,2]},{"code":401,"indent":1,"parameters":["You- you don’t give us any money here???? How am I meant to pay?"]},{"code":231,"indent":1,"parameters":[10,"mononekonameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Mononeko2",3,0,2]},{"code":401,"indent":1,"parameters":["Same way as you pay for anything here, baby- content!"]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku4",6,0,2]},{"code":401,"indent":1,"parameters":["…Isn’t having a movie night enough content for you? Isn’t that going "]},{"code":401,"indent":1,"parameters":["to bring in more views?"]},{"code":231,"indent":1,"parameters":[10,"mononekonameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Mononeko",7,0,2]},{"code":401,"indent":1,"parameters":["Unless you and Zeke are going at it sloppy style on the couch it’ll "]},{"code":401,"indent":1,"parameters":["only cause a small spike, from my estimates-"]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku4",6,0,2]},{"code":401,"indent":1,"parameters":["I’m not doing that."]},{"code":231,"indent":1,"parameters":[10,"mononekonameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Mononeko",4,0,2]},{"code":401,"indent":1,"parameters":["Then you gotta give me content another way! No views, no deal! That’s "]},{"code":401,"indent":1,"parameters":["how it works! You can have your stupid movie when you’re a fan favourite, "]},{"code":401,"indent":1,"parameters":["got it?"]},{"code":101,"indent":1,"parameters":["Mononeko2",1,0,2]},{"code":401,"indent":1,"parameters":["Unless… Well… There’s one small thing you could do."]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku",3,0,2]},{"code":401,"indent":1,"parameters":["…What is it?"]},{"code":231,"indent":1,"parameters":[10,"mononekonameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Mononeko",6,0,2]},{"code":401,"indent":1,"parameters":["I feel like there hasn’t been enough drama around here, you get me Shinku? "]},{"code":401,"indent":1,"parameters":["Not enough conflict… You know who I feel needs to be knocked down a few "]},{"code":401,"indent":1,"parameters":["pegs?"]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku",5,0,2]},{"code":401,"indent":1,"parameters":["Who..?"]},{"code":231,"indent":1,"parameters":[10,"mononekonameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Mononeko2",4,0,2]},{"code":401,"indent":1,"parameters":["Takiko! I mean, what’s with her? Walking around like she owns the "]},{"code":401,"indent":1,"parameters":["place? Like she doesn’t *care* about her verdict? Like it doesn’t "]},{"code":401,"indent":1,"parameters":["affect her? It’s ridiculous! "]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku",2,0,2]},{"code":401,"indent":1,"parameters":["I think that’s being a little harsh… I don’t want to do anything that’ll "]},{"code":401,"indent":1,"parameters":["hurt her, she clearly does care-"]},{"code":231,"indent":1,"parameters":[10,"mononekonameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Mononeko",2,0,2]},{"code":401,"indent":1,"parameters":["Ohhh, don’t you worry, it really won’t be anything at all- she won’t even "]},{"code":401,"indent":1,"parameters":["realise you did anything!"]},{"code":101,"indent":1,"parameters":["Mononeko2",1,0,2]},{"code":401,"indent":1,"parameters":["I just want you to do a small, tiny, harmless prank. "]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku4",6,0,2]},{"code":401,"indent":1,"parameters":["..."]},{"code":231,"indent":1,"parameters":[10,"mononekonameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Mononeko",6,0,2]},{"code":401,"indent":1,"parameters":["Taka has kept all those frogs in Asuga’s cell, right? He’s been going "]},{"code":401,"indent":1,"parameters":["into their room constantly to feed them… Although if you ask me, "]},{"code":401,"indent":1,"parameters":["he’s mainly just using it as an excuse to talk to Asuga again."]},{"code":101,"indent":1,"parameters":["Mononeko",5,0,2]},{"code":401,"indent":1,"parameters":["Why not knock all three of them down? They’ve all gotten way too comfortable "]},{"code":401,"indent":1,"parameters":["with everything for my liking!"]},{"code":101,"indent":1,"parameters":["Mononeko",2,0,2]},{"code":401,"indent":1,"parameters":["So… If you want your VHS tape, all you need to do is get the frogs "]},{"code":401,"indent":1,"parameters":["from Asuga’s cell and set them free in Takiko’s cell! Harmless and "]},{"code":401,"indent":1,"parameters":["fun, no? "]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku2",4,0,2]},{"code":401,"indent":1,"parameters":["I don’t know… It seems pretty cruel-"]},{"code":231,"indent":1,"parameters":[10,"mononekonameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Mononeko2",4,0,2]},{"code":401,"indent":1,"parameters":["Well I don’t care! If you want your stupid movie it’s either you turn "]},{"code":401,"indent":1,"parameters":["Ezekiel into Efreakiel or release the frogs! That’s my final offer!"]},{"code":231,"indent":1,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["Shinku2",1,0,2]},{"code":401,"indent":1,"parameters":["Fine… Fine-! I’ll think about it-!"]},{"code":235,"indent":1,"parameters":[10]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["\\c[6](I wasn’t entirely sure if getting the VHS was worth it at this point… "]},{"code":401,"indent":1,"parameters":["But-)"]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["\\c[6](I did want to try to make things better between the four of us.)"]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["\\c[6](...And Takiko is a patient and understanding person, I’m sure she "]},{"code":401,"indent":1,"parameters":["wouldn’t freak out about the frogs.)"]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["\\c[6](...Besides no one would *know* I did it.)"]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["\\c[6](...I should consider my options. But if I still want to do "]},{"code":401,"indent":1,"parameters":["movie night, I’m going to have to release those frogs.)"]},{"code":121,"indent":1,"parameters":[169,169,0]},{"code":121,"indent":1,"parameters":[168,168,1]},{"code":123,"indent":1,"parameters":["A",0]},{"code":0,"indent":1,"parameters":[]},{"code":411,"indent":0,"parameters":[]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["\\c[6](It's some logbook of prices... But considering there's no one behind the counter"]},{"code":401,"indent":1,"parameters":["I don't think many people are going to be paying.)"]},{"code":0,"indent":1,"parameters":[]},{"code":412,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"