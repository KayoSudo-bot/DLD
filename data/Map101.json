{"id":13,"name":"EV013","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":21,"switch1Valid":true,"switch2Id":24,"switch2Valid":true,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Ismene","direction":8,"pattern":1,"characterIndex":0},"list":[{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Shinku2",7,0,2]},{"code":401,"indent":0,"parameters":["Ismene? What are you doing in here?"]},{"code":231,"indent":0,"parameters":[10,"Ismenenameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Ismene",6,0,2]},{"code":401,"indent":0,"parameters":["…Ah, apologies… Today has been fairly stressful, I’m just grabbing "]},{"code":401,"indent":0,"parameters":["something to take the edge of."]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Shinku4",2,0,2]},{"code":401,"indent":0,"parameters":["…That being an entire bottle of wine?"]},{"code":231,"indent":0,"parameters":[10,"Ismenenameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Ismene",7,0,2]},{"code":401,"indent":0,"parameters":["Yes and a merlot at that, can you believe it? I’ve really hit rock bottom, "]},{"code":401,"indent":0,"parameters":["it’s dreadful. "]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Shinku",3,0,2]},{"code":401,"indent":0,"parameters":["…Right… So, what exactly-"]},{"code":231,"indent":0,"parameters":[10,"Ismenenameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Ismene3",7,0,2]},{"code":401,"indent":0,"parameters":["Oh, don’t get me started. First, I thought you’d died and I started getting "]},{"code":401,"indent":0,"parameters":["all wretchedly emotional and vulnerable… "]},{"code":101,"indent":0,"parameters":["Ismene3",0,0,2]},{"code":401,"indent":0,"parameters":["Next that silly little motive announcement. When, quite frankly, my "]},{"code":401,"indent":0,"parameters":["crime is already out- I see no reason why any other secret should even "]},{"code":401,"indent":0,"parameters":["concern me."]},{"code":101,"indent":0,"parameters":["Ismene",3,0,2]},{"code":401,"indent":0,"parameters":["Unfortunately, some people here are… So fascinating, really. So goodness "]},{"code":401,"indent":0,"parameters":["knows they’ll be going along with this Truth and Dare nonsense and doing "]},{"code":401,"indent":0,"parameters":["all sorts of ridiculous things, this Prison is going to become a mess. "]},{"code":101,"indent":0,"parameters":["Ismene",2,0,2]},{"code":401,"indent":0,"parameters":["But just as my day couldn’t get even better I ran into that shameless "]},{"code":401,"indent":0,"parameters":["girl and her obnoxious little man thing… Hugging. "]},{"code":101,"indent":0,"parameters":["Ismene2",1,0,2]},{"code":401,"indent":0,"parameters":["Hugging! Like they were both *so* concerned about this motive, like they "]},{"code":401,"indent":0,"parameters":["actually have the intellectual capacity to realise the potential threat "]},{"code":401,"indent":0,"parameters":["that comes with it-"]},{"code":101,"indent":0,"parameters":["Ismene4",7,0,2]},{"code":401,"indent":0,"parameters":["Like they’re not just pretending to care about each other, like it’s "]},{"code":401,"indent":0,"parameters":["not just shallow manipulation and incredibly transactional. "]},{"code":101,"indent":0,"parameters":["Ismene4",7,0,2]},{"code":401,"indent":0,"parameters":["Telling each other ‘it’s going to be okay’, ‘no matter what comes out, "]},{"code":401,"indent":0,"parameters":["what the others think, I’ll always care about you’- "]},{"code":101,"indent":0,"parameters":["Ismene4",2,0,2]},{"code":401,"indent":0,"parameters":["…Saying they’ll… Get through it together…-"]},{"code":101,"indent":0,"parameters":["Ismene4",6,0,2]},{"code":401,"indent":0,"parameters":["..."]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Shinku2",4,0,2]},{"code":401,"indent":0,"parameters":["…Iz?"]},{"code":231,"indent":0,"parameters":[10,"Ismenenameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Ismene4",4,0,2]},{"code":401,"indent":0,"parameters":["…They’re awful for each other, they’re just enabling each other, so… "]},{"code":401,"indent":0,"parameters":["So why do they have to go and be *good* to each other every once in a "]},{"code":401,"indent":0,"parameters":["blue moon, it makes me look completely insane for having a problem with "]},{"code":401,"indent":0,"parameters":["what they’re doing!"]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Shinku",5,0,2]},{"code":401,"indent":0,"parameters":["…That’s your problem here?"]},{"code":231,"indent":0,"parameters":[10,"Ismenenameplate",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Ismene2",6,0,2]},{"code":401,"indent":0,"parameters":["..."]},{"code":101,"indent":0,"parameters":["Ismene4",2,0,2]},{"code":401,"indent":0,"parameters":["…No. Not really."]},{"code":101,"indent":0,"parameters":["Ismene4",7,0,2]},{"code":401,"indent":0,"parameters":["Well, yes, in part… But also-"]},{"code":101,"indent":0,"parameters":["Ismene4",6,0,2]},{"code":401,"indent":0,"parameters":["…Why can’t I have that?"]},{"code":101,"indent":0,"parameters":["Ismene4",5,0,2]},{"code":401,"indent":0,"parameters":["Goodness gracious, that’s disgustingly sappy but-... I don’t want to "]},{"code":401,"indent":0,"parameters":["seem weak or incompetent or childish… I just want to know I have "]},{"code":401,"indent":0,"parameters":["someone."]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["S