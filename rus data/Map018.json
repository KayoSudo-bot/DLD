, но я не думала, что нас с"]},{"code":401,"indent":0,"parameters":["ходу окунут в ведро с ебанутыми тварями."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaPrologue13","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Да пофи-и-иг, не мне их судить- это ваша работа. Только не"]},{"code":401,"indent":0,"parameters":["тупите, блядь, с этим просто потому, что кто-то из них показался"]},{"code":401,"indent":0,"parameters":["вам симпатичным."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaPrologue14b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["На этих трансляциях, каждый раз когда у нас будет такой вот"]},{"code":401,"indent":0,"parameters":["вброс с досье и мы покажем, какой херни натворили эти"]},{"code":401,"indent":0,"parameters":["богатенькие идиоты, ваша задача — вынести им приговор."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaPrologue15b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Вы можете решить, что Заключённый прогнил насквозь и, типа,"]},{"code":401,"indent":0,"parameters":["заслуживает смерти или вроде того. И мы поступим с ним"]},{"code":401,"indent":0,"parameters":["соответственно."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaPrologue16","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Честно, большинство этих коров такого приговора и заслуживает."]},{"code":401,"indent":0,"parameters":["Не ведитесь на крокодильи слёзы и жалостливые истории о том,"]},{"code":401,"indent":0,"parameters":["как папа отобрал телефон на неделю."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaPrologue17","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Помните: за каждым миллионером, который «всего добился сам»,"]},{"code":401,"indent":0,"parameters":["стоит папаша-миллиардер с алмазной шахтой."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaPrologue18","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Но если мы вдруг умудрились ошибиться и среди этой кучи"]},{"code":401,"indent":0,"parameters":["Абсолютного говна гипотетически затесался более-менее"]},{"code":401,"indent":0,"parameters":["приличный человек, вы можете проголосовать за его"]},{"code":401,"indent":0,"parameters":["«Искупление»."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaPrologue19b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Только таких много не будет, правда? Не думаете же вы всерьёз,"]},{"code":401,"indent":0,"parameters":["что хоть кто-то из этих блатных сучек — хороший человек."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaPrologue20b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Голосуйте с умом: приговоры бьют по заключённым сильнее всего-"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaPrologue21c_01","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Как знать, вдруг кто-то узнает, что вы считаете его достойным"]},{"code":401,"indent":0,"parameters":["искупления, и у него в голове рванёт бомба самодовольного"]},{"code":401,"indent":0,"parameters":["эгоизма — а вы тут же пожалеете, что нельзя переголосовать."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaPrologue22","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Знайте одно: как бы вы ни проголосовали, начнётся пиздец, и я"]},{"code":401,"indent":0,"parameters":["ОБОЖАЮ это!"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaPrologue23","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Ссылка, где можно выносить приговоры, должна быть где-то на"]},{"code":401,"indent":0,"parameters":["странице трансляции или там, откуда вы её скачали… Если вы"]},{"code":401,"indent":0,"parameters":["смотрите запись- то хер вам, дружок!"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaPrologue24","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Остаётся надеяться, что те, кто смотрел вживую, голосовали не"]},{"code":401,"indent":0,"parameters":["как малолетки!"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaPrologue25","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Без обид, уверена, *некоторые* из вас умные. Но когда голосует"]},{"code":401,"indent":0,"parameters":["большая толпа, среди неё всегда найдётся кучка дебилов."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaPrologue26","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["А теперь нам надо вырубить трансляцию на совсе-е-ем чуть-чуть,"]},{"code":401,"indent":0,"parameters":["на необходимое обслуживание… И чтобы сменить адреса, пока"]},{"code":401,"indent":0,"parameters":["федералы нас не накрыли."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaPrologue27","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Они скоро сдадутся, их ленивым задницам ни на что не хватает"]},{"code":401,"indent":0,"parameters":["упорства. Но приве-е-ет, агент ФБР, если ты смотришь: готовься"]},{"code":401,"indent":0,"parameters":["играть в догонялки очень долго, если хочешь нас заткнуть!"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaPrologue28","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["А вы, блядь, ведите себя прилично при голосовании, ясно? Боже,"]},{"code":401,"indent":0,"parameters":["как же будет приятно наконец поставить этих богатых тварей на"]},{"code":401,"indent":0,"parameters":["место-"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaPrologue29b","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["В следующий раз я вкратце расскажу обо всём, что вы пропустили"]},{"code":401,"indent":0,"parameters":["в Тюрьме, дам сводку по нашим милым Заключённым и раскрою,"]},{"code":401,"indent":0,"parameters":["каковы же были ваши приговоры."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaPrologue30","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Ну и так далее, вы знаете порядок. Вы не безмозглые, мне не надо"]},{"code":401,"indent":0,"parameters":["разжёвывать это как пятилеткам. Если только вы не какой-нибудь"]},{"code":401,"indent":0,"parameters":["мелкий отморозок, смотрящий стримы про смерть."]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"EmiliaPrologue31","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Увидимся в следующий раз на LOCKDOWN. А пока — оставайтесь"]},{"code":401,"indent":0,"parameters":["собой, болтун — находка для шпиона, и не забывайте про неё."]},{"code":251,"indent":0,"parameters":[]},{"code":235,"indent":0,"parameters":[10]},{"code":242,"indent":0,"parameters":[3]},{"code":221,"indent":0,"parameters":[]},{"code":235,"indent":0,"parameters":[5]},{"code":230,"indent":0,"parameters":[300]},{"code":352,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[5,"Akaricg1",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[200]},{"code":241,"indent":0,"parameters":[{"name":"I Still Remember","volume":15,"pitch":100,"pan":0}]},{"code":231,"indent":0,"parameters":[10,"Mysterynameplate",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"AkariPrologue1","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Шинку! Шинку! Эй!"]},{"code":251,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"ShinkuAkari1B","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Секундочку, 'Кари- я почти закончил."]},{"code":251,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[10,"Akarinametag",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"AkariPrologue2","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Лады-лады! Но обещай, что в этот раз правда секундочка! Ты"]},{"code":401,"indent":0,"parameters":["всегда так говоришь, а потом проходят часы-ы-ы, и мне уже пора"]},{"code":401,"indent":0,"parameters":["спать!"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"AkariPrologue3","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["И в этот раз ты обещал на мизинчиках!"]},{"code":251,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[10,"ShinkuNametag",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"ShinkuAkari2B","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Ага… Обещаю- осталось всего пара страниц…"]},{"code":251,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[10,"Mysterynameplate",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"Mother1","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["...Акари, ты опять пристаёшь к брату?"]},{"code":251,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[10,"Akarinametag",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"AkariPrologue4","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Не-е-ет-"]},{"code":251,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[10,"Mysterynameplate",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"Mother2","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Акари! Он сейчас работает, спускайся вниз, ты его отвлекаешь-"]},{"code":401,"indent":0,"parameters":["его работа очень важна, пора бы уже это понимать."]},{"code":251,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[10,"Akarinametag",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"AkariPrologue8","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},